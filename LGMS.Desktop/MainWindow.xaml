<Window x:Class="LGMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:LGMS.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LGMS — Local Git Management System"
        Icon="app.ico"
        Height="890" Width="1440"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkestBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.InputBindings>
        <KeyBinding Key="Space" Modifiers="Control" Command="{Binding OpenVoiceAssistantCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar & Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Workspace / Main Body -->
            <RowDefinition Height="*" />
            <!-- Status & Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR & REPO SELECTOR ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" ClipToBounds="True" Background="#0b0f19" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                        <Image Source="app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LGMS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Desktop .NET 9" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Workspace Directory Selector & Git Project Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="4,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkspacePath}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Width="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding WorkspacePath}" />
                            <Button Content="Browse..." Style="{DynamicResource SecondaryButton}" Command="{Binding BrowseFolderCommand}" Padding="8,3" FontSize="11" Margin="8,0,2,0" />
                            <Button ToolTip="Rescan workspace" Style="{DynamicResource SecondaryButton}" Command="{Binding ScanWorkspaceCommand}" Padding="6,3" Margin="4,0,0,0">
                                <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Clone Repo Action Button -->
                    <Button ToolTip="Clone a remote repository into a selected folder" Style="{DynamicResource PrimaryButton}" Command="{Binding CloneRepoCommand}" Padding="10,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPull}" Fill="#ffffff" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clone Repo" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Add Project To GIT Action Button -->
                    <Button ToolTip="Select any folder to initialize git and commit as Initial Commit" Style="{DynamicResource SecondaryButton}" Command="{Binding AddProjectToGitCommand}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Fill="#4ade80" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Project To GIT" FontSize="11" FontWeight="SemiBold" Foreground="#4ade80" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Voice AI Assistant Action Button -->
                    <Button ToolTip="Open AI Voice Assistant Copilot (Ctrl+Space)" Style="{DynamicResource SecondaryButton}" Command="{Binding OpenVoiceAssistantCommand}" Padding="10,5" Margin="6,0,0,0" BorderBrush="#06b6d4" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎤" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Voice AI" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Active Repo Banner & Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasActiveRepo, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveRepository.Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Background="#1e3a8a" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBranch}" Fill="#93c5fd" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveRepository.CurrentBranch}" FontSize="11" FontWeight="SemiBold" Foreground="#93c5fd" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Ahead / Behind Pills -->
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Border Background="#1e3a8a" CornerRadius="3" Padding="4,1" Margin="2,0" Visibility="{Binding ActiveRepository.AheadCount, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="{Binding ActiveRepository.AheadCount, StringFormat='↑{0}'}" FontSize="10" Foreground="#93c5fd" FontWeight="Bold" />
                                </Border>
                                <Border Background="#7f1d1d" CornerRadius="3" Padding="4,1" Margin="2,0" Visibility="{Binding ActiveRepository.BehindCount, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="{Binding ActiveRepository.BehindCount, StringFormat='↓{0}'}" FontSize="10" Foreground="#fca5a5" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Git Sync Action Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button ToolTip="Fetch remote changes" Style="{DynamicResource SecondaryButton}" Command="{Binding FetchCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFetch}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Fetch" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Pull changes from remote" Style="{DynamicResource SecondaryButton}" Command="{Binding PullCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPull}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pull" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Push commits to remote" Style="{DynamicResource SecondaryButton}" Command="{Binding PushCommand}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPush}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Push" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Refresh status" Style="{DynamicResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,0" Padding="8,6">
                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Right Toolset: Theme Toggle + External Launchers -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Toggle Button (Light / Dark) -->
                    <Button ToolTip="Toggle Light / Dark Theme" Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Margin="0,0,8,0" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSun}" Fill="{DynamicResource AccentAmberBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding CurrentTheme}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button ToolTip="Open in Visual Studio Code" Style="{DynamicResource SecondaryButton}" Command="{Binding OpenInVsCodeCommand}" Margin="0,0,6,0" Padding="8,6">
                        <Path Data="{StaticResource IconVsCode}" Fill="{DynamicResource AccentPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button ToolTip="Open in File Explorer" Style="{DynamicResource SecondaryButton}" Command="{Binding OpenInExplorerCommand}" Margin="0,0,6,0" Padding="8,6">
                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button ToolTip="Open External PowerShell Terminal" Style="{DynamicResource SecondaryButton}" Command="{Binding OpenTerminalCommand}" Padding="8,6">
                        <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY (2 COLUMNS) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Repositories Panel -->
                <ColumnDefinition Width="290" MinWidth="220" MaxWidth="450" />
                <ColumnDefinition Width="Auto" />
                <!-- Right Workspace Views -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: REPOSITORY LIST -->
            <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="REPOSITORIES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding FilteredRepositories.Count}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Quick Action Buttons for Repositories -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ Clone Repo" Style="{DynamicResource SecondaryButton}" Command="{Binding CloneRepoCommand}" Padding="6,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" ToolTip="Clone a remote repository into a selected folder" />
                        <Button Grid.Column="1" Content="+ Add Project" Style="{DynamicResource SecondaryButton}" Command="{Binding AddProjectToGitCommand}" Padding="6,4" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" ToolTip="Initialize folder as Git repository with Initial Commit" />
                    </Grid>

                    <!-- Filter Search Box -->
                    <TextBox Grid.Row="2" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Tag="Filter repositories..." />

                    <!-- Repositories List -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding FilteredRepositories}"
                             SelectedItem="{Binding ActiveRepository, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Path Data="{StaticResource IconBranch}" Fill="{DynamicResource AccentPrimaryBrush}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CurrentBranch}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="5,2" Background="#166534" Visibility="{Binding IsClean, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="clean" FontSize="10" FontWeight="Bold" Foreground="#86efac" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="5,2" Background="#854d0e" Visibility="{Binding IsClean, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding ChangesCount, StringFormat='{}{0} chg'}" FontSize="10" FontWeight="Bold" Foreground="#fef08a" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- RIGHT MAIN WORKSPACE -->
            <Grid Grid.Column="2" Background="{DynamicResource BgDarkestBrush}">
                <Grid.RowDefinitions>
                    <!-- Nav Tabs -->
                    <RowDefinition Height="Auto" />
                    <!-- Tab View Content -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Tabs Header -->
                <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Tab 0: Changes -->
                        <RadioButton GroupName="NavTabs" Tag="0" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=0}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ Changes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                            <Border CornerRadius="8" Background="{DynamicResource BgCardBrush}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.CurrentStatus.Changes.Count, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=0}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 1: History -->
                        <RadioButton GroupName="NavTabs" Tag="1" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=1}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="📜 History &amp; Commits" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 2: Branches -->
                        <RadioButton GroupName="NavTabs" Tag="2" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=2}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="🌿 Branches" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 3: Stashes -->
                        <RadioButton GroupName="NavTabs" Tag="3" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=3}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="📦 Stashes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 4: Remotes -->
                        <RadioButton GroupName="NavTabs" Tag="4" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=4}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="🌐 Remotes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 5: Terminal -->
                        <RadioButton GroupName="NavTabs" Tag="5" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=5}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="💻 Git Console" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 6: Settings -->
                        <RadioButton GroupName="NavTabs" Tag="6" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=6}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="⚙️ Settings" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Tab 7: GitHub Integration -->
                        <RadioButton GroupName="NavTabs" Tag="7" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=7}" Click="OnTabSelected" Style="{x:Null}">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,12" Background="Transparent" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🐙 GitHub" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" x:Name="txt" />
                                            <Border CornerRadius="8" Background="{DynamicResource BgCardBrush}" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding GitHubAccounts.Count, Converter={StaticResource CountToVis}}">
                                                <TextBlock Text="{Binding GitHubAccounts.Count}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- ================= TAB CONTENT PAGES ================= -->

                <!-- ================= TAB 0: WORKING CHANGES & COMMIT ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                    <Grid.ColumnDefinitions>
                        <!-- Staging & Commit Left Panel -->
                        <ColumnDefinition Width="380" MinWidth="300" MaxWidth="550" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Diff Viewer Right Panel -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Staged / Unstaged Lists + Commit Box -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <!-- Staged Section -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="90" />
                                <!-- Unstaged Section -->
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="90" />
                                <!-- Commit Box -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Staged Changes Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="STAGED CHANGES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentEmeraldBrush}" />
                                    <Border Background="#166534" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding StagedChanges.Count}" FontSize="10" Foreground="#86efac" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <Button Content="Unstage All" Style="{DynamicResource SecondaryButton}" Command="{Binding UnstageAllCommand}" HorizontalAlignment="Right" Padding="6,2" FontSize="11" />
                            </Grid>

                            <!-- Staged Changes List -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding StagedChanges}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding Status, Converter={StaticResource StatusToBrush}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusCode}" FontSize="10" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Content="−" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.UnstageItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Unstage file" Padding="6,1" FontSize="11" Margin="4,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Unstaged Changes Header -->
                            <Grid Grid.Row="2" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="UNSTAGED CHANGES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentAmberBrush}" />
                                    <Border Background="#854d0e" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding UnstagedChanges.Count}" FontSize="10" Foreground="#fef08a" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Discard" Style="{DynamicResource SecondaryButton}" Command="{Binding DiscardSelectedCommand}" ToolTip="Discard selected files" Padding="6,2" FontSize="11" Margin="0,0,4,0" />
                                    <Button Content="Stage All" Style="{DynamicResource SecondaryButton}" Command="{Binding StageAllCommand}" Padding="6,2" FontSize="11" />
                                </StackPanel>
                            </Grid>

                            <!-- Unstaged Changes List -->
                            <ListBox Grid.Row="3" ItemsSource="{Binding UnstagedChanges}" SelectedItem="{Binding SelectedChange, Mode=TwoWay}" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Grid.Column="1" CornerRadius="3" Background="{Binding Status, Converter={StaticResource StatusToBrush}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusCode}" FontSize="10" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="+" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.StageItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Stage file" Padding="6,1" FontSize="11" Margin="4,0,2,0" />
                                            <Button Grid.Column="4" ToolTip="Discard file changes" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.DiscardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10">
                                                <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource AccentRoseBrush}" Width="10" Height="10" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Commit Box Card -->
                            <Border Grid.Row="4" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="COMMIT CHANGES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        
                                        <!-- AI Commit Auto-Generate Header Badge -->
                                        <Border Grid.Column="1" Background="#312e81" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSparkle}" Fill="#c7d2fe" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="AI Powered" FontSize="10" FontWeight="SemiBold" Foreground="#c7d2fe" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- AI Provider & Model Controls Row -->
                                    <Border Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,5" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Provider Dropdown -->
                                            <ComboBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding AvailableAiProviders}" SelectedItem="{Binding SelectedAiProvider}" FontSize="11" Padding="4,2" Margin="0,0,4,0" ToolTip="Select AI Provider" />

                                            <!-- Model Dropdown -->
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}" FontSize="11" Padding="4,2" Margin="0,0,4,0" ToolTip="Select AI Model" />

                                            <!-- Generate AI Button -->
                                            <Button Grid.Row="0" Grid.Column="2" Style="{DynamicResource PrimaryButton}" Command="{Binding AutoGenerateCommitCommand}" Padding="8,3" FontSize="11" ToolTip="Auto-generate commit message using AI">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconSparkle}" Fill="#ffffff" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="AI Generate" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- AI Status Feedback Banner -->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" CornerRadius="4" Padding="6,3" Background="{DynamicResource BgInputBrush}" Visibility="{Binding AiStatusMessage, Converter={StaticResource NotNullToVis}}">
                                                <TextBlock Text="{Binding AiStatusMessage}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <TextBox Text="{Binding CommitSubject, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Tag="Commit summary (e.g. feat: add desktop UI)" />
                                    <TextBox Text="{Binding CommitDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,10" Tag="Description (optional details)..." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Commit" Style="{DynamicResource SuccessButton}" Command="{Binding CommitCommand}" Margin="0,0,4,0" />
                                        <Button Grid.Column="1" Content="Commit &amp; Push" Style="{DynamicResource PrimaryButton}" Command="{Binding CommitAndPushCommand}" Margin="4,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                    <!-- Right: Diff Inspector -->
                    <Grid Grid.Column="2" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Diff Header -->
                        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DIFF INSPECTOR:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SelectedChange.Path, FallbackValue='Select a changed file on the left to view diff'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Diff Content ListView -->
                        <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DiffLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Text, Converter={StaticResource DiffLineBg}}" Padding="4,1" Margin="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding OldLineNumber}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" TextAlignment="Right" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" TextAlignment="Right" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= TAB 1: COMMIT HISTORY & PAGES INSPECTOR ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="130" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="220" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Commits List & Commit Actions -->
                    <Border Grid.Row="0" Margin="14,14,14,0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Commits Header Bar with Commit Actions -->
                            <Border Grid.Row="0" Background="{DynamicResource BgCardHoverBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📜 Commit Log" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Commits.Count, StringFormat='{}{0} commits'}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Commit-level Actions: Restore All, Revert -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SelectedCommit, Converter={StaticResource NullToVis}}">
                                        <Button Content="↩ Restore All to System" Margin="0,0,8,0" Padding="10,4" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding RestoreAllFromSelectedCommitCommand}" ToolTip="Restore all modified files from this commit into your workspace" />
                                        <Button Content="⚡ Revert Commit" Padding="10,4" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding RevertSelectedCommitCommand}" ToolTip="Create a reverse commit to undo this commit" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Commits ListView -->
                            <ListView Grid.Row="1" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Commit" Width="85">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding ShortHash}" Foreground="{DynamicResource AccentPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Subject" Width="420">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Subject}" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Author" Width="170">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding AuthorName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Date" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RelativeTime}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="4" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14,4" />

                    <!-- Bottom Row: 2-Column Split (Left = Pages Changed in Commit, Right = IDE/Side-by-Side Compare) -->
                    <Grid Grid.Row="2" Margin="14,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="220" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Changed Pages in Commit List -->
                        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Background="{DynamicResource BgCardHoverBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁 Changed Pages / Files" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                        <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CommitFiles.Count}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Pages List -->
                                <ListView Grid.Row="1" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,2" Padding="8,6" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- File Name & Status Badge -->
                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                        <Border DockPanel.Dock="Right" Background="{Binding Status, Converter={StaticResource StatusToBrush}}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusCode}" FontSize="9" FontWeight="Bold" Foreground="#090d16" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                    </DockPanel>

                                                    <!-- Stats & Quick Actions -->
                                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Additions / Deletions -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Additions, StringFormat='+{0}'}" FontSize="10" FontWeight="Bold" Foreground="#4ade80" Margin="0,0,6,0" Visibility="{Binding Additions, Converter={StaticResource CountToVis}}" />
                                                            <TextBlock Text="{Binding Deletions, StringFormat='-{0}'}" FontSize="10" FontWeight="Bold" Foreground="#f87171" Visibility="{Binding Deletions, Converter={StaticResource CountToVis}}" />
                                                        </StackPanel>

                                                        <!-- Per-file buttons: Download, Restore -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="⬇ Download" Margin="0,0,4,0" Padding="6,2" FontSize="10" Style="{DynamicResource SecondaryButton}" 
                                                                    Command="{Binding DataContext.DownloadCommitFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Export/Download this specific file from commit" />
                                                            <Button Content="↩ Restore" Padding="6,2" FontSize="10" Style="{DynamicResource SecondaryButton}" 
                                                                    Command="{Binding DataContext.RestoreCommitFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                                    CommandParameter="{Binding}" ToolTip="Restore this page into your workspace" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0" />

                        <!-- Right Column: Inspector Workspace (Side-by-Side Compare & Edit-Type IDE) -->
                        <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Inspector Header / Tabs & Actions -->
                                <Border Grid.Row="0" Background="{DynamicResource BgCardHoverBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Inspector Tabs -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton Content="⚡ Side-by-Side Compare" Tag="0" GroupName="InspectorSubTabs" IsChecked="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=0}" Style="{x:Null}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="b" CornerRadius="4" Padding="8,4" Background="Transparent" Cursor="Hand" Margin="0,0,4,0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgDarkBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>

                                            <RadioButton Content="💻 Edit-Type IDE (Ctrl+F)" Tag="1" GroupName="InspectorSubTabs" IsChecked="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=1}" Style="{x:Null}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="b" CornerRadius="4" Padding="8,4" Background="Transparent" Cursor="Hand" Margin="0,0,4,0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgDarkBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>

                                            <RadioButton Content="📄 Unified Patch" Tag="2" GroupName="InspectorSubTabs" IsChecked="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=2}" Style="{x:Null}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="b" CornerRadius="4" Padding="8,4" Background="Transparent" Cursor="Hand" Margin="0,0,4,0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgDarkBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>

                                            <RadioButton Content="📜 Full Commit" Tag="3" GroupName="InspectorSubTabs" IsChecked="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToBool}, ConverterParameter=3}" Style="{x:Null}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="b" CornerRadius="4" Padding="8,4" Background="Transparent" Cursor="Hand">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BgDarkBrush}" />
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </StackPanel>

                                        <!-- Quick Actions for Selected File -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Download Selected -->
                                            <Button Content="⬇ Download Page" Margin="0,0,6,0" Padding="8,3" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding DownloadCommitFileCommand}" ToolTip="Save this page snapshot to disk" />
                                            <!-- Restore Selected -->
                                            <Button Content="↩ Restore to Workspace" Margin="0,0,6,0" Padding="8,3" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding RestoreCommitFileCommand}" ToolTip="Restore this page back to working directory" />
                                            <!-- Toggle Edit Mode -->
                                            <Button Content="✏ Edit / View Mode" Margin="0,0,6,0" Padding="8,3" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleIdeEditModeCommand}" ToolTip="Toggle edit mode to check and update file" />
                                            <!-- Save & Update to Disk -->
                                            <Button Content="💾 Save &amp; Update to Disk" Padding="10,3" FontSize="11" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveIdeUpdatedContentCommand}" Visibility="{Binding IsIdeEditMode, Converter={StaticResource BoolToVis}}" ToolTip="Save updated code directly to workspace file on disk" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Inspector Viewport Tabs -->
                                <Grid Grid.Row="1">
                                    <!-- View 0: Side-by-Side Diff Compare -->
                                    <Grid Visibility="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- Side by Side Column Headers -->
                                        <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="◀ Before (Parent Commit)" FontWeight="Bold" FontSize="11" Foreground="#f87171" HorizontalAlignment="Center" />
                                                <Rectangle Grid.Column="1" Fill="{DynamicResource BorderDarkBrush}" />
                                                <TextBlock Grid.Column="2" Text="▶ After (This Commit)" FontWeight="Bold" FontSize="11" Foreground="#4ade80" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Side by Side Rows ItemsControl / ListView -->
                                        <ListView Grid.Row="1" ItemsSource="{Binding SideBySideDiffRows}" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Code, Consolas" FontSize="11">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Cell (Deletions / Before) -->
                                                        <Border Grid.Column="0" Background="{Binding LeftType, Converter={StaticResource DiffTypeBg}}" Padding="4,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding LeftLineNumber}" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding LeftText}" Foreground="{Binding LeftType, Converter={StaticResource DiffTypeFg}}" TextWrapping="NoWrap" />
                                                            </Grid>
                                                        </Border>

                                                        <Rectangle Grid.Column="1" Fill="{DynamicResource BorderDarkBrush}" />

                                                        <!-- Right Cell (Additions / After) -->
                                                        <Border Grid.Column="2" Background="{Binding RightType, Converter={StaticResource DiffTypeBg}}" Padding="4,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding RightLineNumber}" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding RightText}" Foreground="{Binding RightType, Converter={StaticResource DiffTypeFg}}" TextWrapping="NoWrap" />
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>

                                    <!-- View 1: Edit-Type IDE (with Ctrl+F Search Bar) -->
                                    <Grid Visibility="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Ctrl+F Search Bar Floating Widget -->
                                        <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Margin="10,6" Padding="8,4" Visibility="{Binding IsIdeSearchVisible, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Find Bar -->
                                                <DockPanel Grid.Row="0" LastChildFill="True">
                                                    <!-- Close Search Button -->
                                                    <Button DockPanel.Dock="Right" Content="✕" Margin="6,0,0,0" Padding="6,2" FontSize="11" Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleIdeSearchCommand}" ToolTip="Close (Esc)" />
                                                    <!-- Next Match Button -->
                                                    <Button DockPanel.Dock="Right" Content="▼" Margin="4,0,0,0" Padding="6,2" FontSize="10" Style="{DynamicResource SecondaryButton}" Command="{Binding IdeFindNextCommand}" ToolTip="Next Match (Enter)" />
                                                    <!-- Previous Match Button -->
                                                    <Button DockPanel.Dock="Right" Content="▲" Margin="4,0,0,0" Padding="6,2" FontSize="10" Style="{DynamicResource SecondaryButton}" Command="{Binding IdeFindPreviousCommand}" ToolTip="Previous Match (Shift+Enter)" />
                                                    <!-- Match Counter Badge -->
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BgCardHoverBrush}" CornerRadius="3" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding IdeSearchCounterText}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontFamily="Cascadia Code, Consolas" />
                                                    </Border>
                                                    <!-- Search Input Box -->
                                                    <TextBox x:Name="IdeSearchTextBox" Text="{Binding IdeSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="12" FontFamily="Cascadia Code, Consolas" />
                                                </DockPanel>

                                                <!-- Replace Bar (Visible in Edit Mode) -->
                                                <DockPanel Grid.Row="1" Margin="0,4,0,0" Visibility="{Binding IsIdeEditMode, Converter={StaticResource BoolToVis}}">
                                                    <Button DockPanel.Dock="Right" Content="Replace All" Margin="6,0,0,0" Padding="8,2" FontSize="10" Style="{DynamicResource SecondaryButton}" Command="{Binding IdeReplaceAllCommand}" />
                                                    <Button DockPanel.Dock="Right" Content="Replace" Margin="6,0,0,0" Padding="8,2" FontSize="10" Style="{DynamicResource SecondaryButton}" Command="{Binding IdeReplaceCurrentCommand}" />
                                                    <TextBox x:Name="IdeReplaceTextBox" Text="{Binding IdeReplaceQuery, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="12" FontFamily="Cascadia Code, Consolas" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <!-- IDE Code Editor Workspace -->
                                        <Border Grid.Row="1" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Gutter Line Numbers -->
                                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="0,6,6,6">
                                                    <TextBlock Text="{Binding IdeLineNumbersText}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                </ScrollViewer>

                                                <!-- Code Text Box -->
                                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6">
                                                    <TextBox x:Name="IdeCodeTextBox" Text="{Binding IdeContent, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsIdeEditMode, Converter={StaticResource InverseBool}}" AcceptsReturn="True" AcceptsTab="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="NoWrap" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <!-- IDE Status Bar -->
                                        <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" Padding="10,4">
                                            <DockPanel LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SelectedCommit.ShortHash, StringFormat='Commit: {0}'}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="10" FontFamily="Cascadia Code, Consolas" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding IsIdeEditMode, Converter={StaticResource BoolToPrivateString}, ConverterParameter='[EDIT MODE]|[READ ONLY]'}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentAmberBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding IdeStatsText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontFamily="Cascadia Code, Consolas" />
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- View 2: Unified Diff -->
                                    <Grid Visibility="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                                            <TextBox Text="{Binding SelectedCommitFileDiff, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="NoWrap" />
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- View 3: Full Commit Patch -->
                                    <Grid Visibility="{Binding CommitInspectorTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                                            <TextBox Text="{Binding CommitDiffText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="NoWrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= TAB 2: BRANCHES ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Create Branch Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Create New Branch:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="NewBranchInput" Margin="0,0,10,0" Tag="e.g. feature/login-page" />
                            <Button Grid.Column="2" Content="Create &amp; Switch" Style="{DynamicResource PrimaryButton}" Click="OnCreateBranchClicked" />
                        </Grid>
                    </Border>

                    <!-- Branches Table -->
                    <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <ListView ItemsSource="{Binding Branches}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Status" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#166534" CornerRadius="4" Padding="6,2" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="CURRENT" FontSize="9" FontWeight="Bold" Foreground="#86efac" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Branch Name" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconBranch}" Fill="{DynamicResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Upstream" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Upstream, FallbackValue='—'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Latest Commit" Width="350">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LatestCommitSubject}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Actions" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Checkout" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.CheckoutBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Padding="8,2" FontSize="11" Margin="0,0,6,0" Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVis}}" />
                                                    <Button Content="Delete" Style="{DynamicResource DangerButton}" Command="{Binding DataContext.DeleteBranchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Padding="8,2" FontSize="11" Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- ================= TAB 3: STASHES ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=3}" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Save Stash:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="NewStashInput" Margin="0,0,10,0" Tag="Optional stash message..." />
                            <Button Grid.Column="2" Content="Stash All Changes" Style="{DynamicResource PrimaryButton}" Click="OnSaveStashClicked" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <ListView ItemsSource="{Binding Stashes}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Ref" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RefName}" FontFamily="Cascadia Code, Consolas" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Message" Width="450">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Time" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Actions" Width="220">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Apply" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.ApplyStashCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RefName}" Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                                                    <Button Content="Pop" Style="{DynamicResource SuccessButton}" Command="{Binding DataContext.PopStashCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RefName}" Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                                                    <Button Content="Drop" Style="{DynamicResource DangerButton}" Command="{Binding DataContext.DropStashCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RefName}" Padding="8,2" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- ================= TAB 4: REMOTES ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=4}" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Add Remote:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="RemoteNameInput" Margin="0,0,10,0" Tag="origin" />
                            <TextBlock Grid.Column="2" Text="URL:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="3" x:Name="RemoteUrlInput" Margin="0,0,10,0" Tag="https://github.com/..." />
                            <Button Grid.Column="4" Content="Add Remote" Style="{DynamicResource PrimaryButton}" Click="OnAddRemoteClicked" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6">
                        <ListView ItemsSource="{Binding Remotes}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fetch URL" Width="420">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FetchUrl}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Actions" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Style="{DynamicResource DangerButton}" Command="{Binding DataContext.RemoveRemoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Padding="8,2" FontSize="11" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <!-- ================= TAB 5: GIT TERMINAL ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=5}" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentPrimaryBrush}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Input Bar -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="git " FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Tag="Type git arguments (e.g. status, log --oneline, diff)..." KeyDown="OnTerminalInputKeyDown" />
                        <Button Grid.Column="2" Content="Run" Style="{DynamicResource PrimaryButton}" Command="{Binding ExecuteTerminalCommand}" Margin="0,0,6,0" />
                        <Button Grid.Column="3" Content="Clear" Style="{DynamicResource SecondaryButton}" Command="{Binding ClearTerminalCommand}" />
                    </Grid>
                </Grid>

                <!-- ================= TAB 6: SETTINGS ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=6}" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="Application &amp; Workspace Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                            <!-- Workspace Folder Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Default Workspace Path" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="The root folder where LGMS will automatically discover all local Git repositories on startup." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding DefaultWorkspacePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="Browse..." Style="{DynamicResource SecondaryButton}" Command="{Binding BrowseFolderCommand}" />
                                    </Grid>
                                    <Button Content="Save Path Settings" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- Theme Selection Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Theme &amp; Appearance" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Choose between Sleek Dark Theme or Clean White / Light Theme." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="🌙 Dark Theme" Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Margin="0,0,10,0" Padding="16,8" />
                                        <Button Content="☀️ Light (White) Theme" Style="{DynamicResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Padding="16,8" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Global Git Author Credentials Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Git Author Profile" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Configures your global user.name and user.email for Git commits." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GitUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GitUserEmail, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Button Content="Save Git Profile" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveGitConfigCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <!-- AI Automation Settings Card -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="AI Commit Automation &amp; API Keys" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#312e81" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSparkle}" Fill="#c7d2fe" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Gemini &amp; DeepSeek" FontSize="10" FontWeight="SemiBold" Foreground="#c7d2fe" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Configure AI models and API credentials to generate conventional commit messages with one click." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" />

                                    <!-- Provider & Model Configuration -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Active AI Provider:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableAiProviders}" SelectedItem="{Binding SelectedAiProvider}" FontSize="12" Margin="0,0,0,10" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Active Model:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}" FontSize="12" Margin="0,0,0,10" />
                                    </Grid>

                                    <!-- API Keys -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Google Gemini Key:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GeminiApiKeyInput, UpdateSourceTrigger=PropertyChanged}" Tag="Paste your Google Gemini API Key" Margin="0,0,0,10" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="DeepSeek API Key:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeepSeekApiKeyInput, UpdateSourceTrigger=PropertyChanged}" Tag="Paste your DeepSeek API Key" Margin="0,0,0,10" />
                                    </Grid>

                                    <!-- Action Buttons & Status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="Test Gemini API" Style="{DynamicResource SecondaryButton}" Command="{Binding TestAiConnectionCommand}" CommandParameter="Gemini" Margin="0,0,8,0" Padding="12,6" />
                                        <Button Content="Test DeepSeek API" Style="{DynamicResource SecondaryButton}" Command="{Binding TestAiConnectionCommand}" CommandParameter="DeepSeek" Margin="0,0,8,0" Padding="12,6" />
                                        <Button Content="Save AI Settings" Style="{DynamicResource PrimaryButton}" Command="{Binding SaveAiSettingsCommand}" Padding="16,6" />
                                    </StackPanel>

                                    <!-- Test Feedback -->
                                    <Border CornerRadius="4" Padding="8,6" Background="{DynamicResource BgInputBrush}" Visibility="{Binding AiTestStatus, Converter={StaticResource NotNullToVis}}">
                                        <TextBlock Text="{Binding AiTestStatus}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostics & System Info -->
                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics &amp; Environment" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Git Executable Status: " FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding GitVersion}" FontSize="12" Foreground="{DynamicResource AccentEmeraldBrush}" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Active Runtime: " FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text=".NET 9.0 (WPF Native Desktop x64)" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= TAB 7: GITHUB INTEGRATION ================= -->
                <Grid Grid.Row="1" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=7}">
                    <Grid.ColumnDefinitions>
                        <!-- Accounts Left Sidebar -->
                        <ColumnDefinition Width="340" MinWidth="280" MaxWidth="480" />
                        <ColumnDefinition Width="Auto" />
                        <!-- Repositories Right Panel -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Authenticated GitHub Accounts -->
                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,1,0" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="GITHUB ACCOUNTS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <Button Content="↻ Refresh" Style="{DynamicResource SecondaryButton}" Command="{Binding RefreshGitHubAccountsCommand}" HorizontalAlignment="Right" Padding="8,3" FontSize="11" />
                                </Grid>
                                <TextBlock Text="Select an account to browse and clone remote repositories." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Accounts ListBox -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding GitHubAccounts}" SelectedItem="{Binding SelectedGitHubAccount, Mode=TwoWay}" Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="{DynamicResource BgCardBrush}" Padding="10,8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="@@" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" FontSize="13" />
                                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Host}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Padding="6,2" Background="#166534" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0">
                                                        <TextBlock Text="Active" FontSize="10" FontWeight="Bold" Foreground="#86efac" />
                                                    </Border>
                                                    <Button Content="Set Active" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.SwitchGitHubAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}" Padding="6,2" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Bottom Quick Auth Helper Card -->
                            <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Connect New Account" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Run in PowerShell for browser login:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="gh auth login --web" IsReadOnly="True" FontSize="11" FontFamily="Consolas, monospace" Background="{DynamicResource BgDarkestBrush}" Padding="6,4" />
                                        <Button Grid.Column="1" Content="Copy" Style="{DynamicResource SecondaryButton}" Command="{Binding CopyCommand}" CommandParameter="gh auth login --web" Margin="4,0,0,0" Padding="8,3" FontSize="11" />
                                    </Grid>
                                    <Button Content="🔑 Configure Git Auth (setup-git)" Style="{DynamicResource SecondaryButton}" Command="{Binding SetupGitCredentialsCommand}" HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="3" Background="{DynamicResource BorderDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                    <!-- Right: Repositories Browser -->
                    <Grid Grid.Column="2" Background="{DynamicResource BgDarkestBrush}" Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Repositories Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Remote Repositories for " FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedGitHubAccount.Username, StringFormat='@@{0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredGitHubRepositories.Count, StringFormat='{}{0} repos'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Button Content="↻ Reload Repos" Style="{DynamicResource SecondaryButton}" Command="{Binding LoadGitHubRepositoriesCommand}" HorizontalAlignment="Right" Padding="10,4" FontSize="12" />
                        </Grid>

                        <!-- Search Filter Box -->
                        <TextBox Grid.Row="1" Text="{Binding GitHubSearchFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" Tag="Filter remote repositories..." />

                        <!-- Repositories Grid List -->
                        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredGitHubRepositories}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="14" Margin="6" Width="320" Height="130">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Title and Private badge -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" ToolTip="{Binding Name}" />
                                                <Border HorizontalAlignment="Right" CornerRadius="4" Padding="5,2" Background="#1e293b" BorderBrush="#334155" BorderThickness="1">
                                                    <TextBlock Text="{Binding IsPrivate, Converter={StaticResource BoolToPrivateString}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Details -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Owner, StringFormat='Owner: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding DefaultBranch, StringFormat='Branch: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <Grid Grid.Row="2">
                                                <Button Content="↗ GitHub" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}" HorizontalAlignment="Left" Padding="8,2" FontSize="11" />
                                                <Button Content="⬇ Clone" Style="{DynamicResource PrimaryButton}" Command="{Binding DataContext.CloneGitHubRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Padding="12,2" FontSize="11" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= STATUS & NOTIFICATION FOOTER ================= -->
        <Border Grid.Row="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Busy Progress Spinner & Message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding BusyMessage}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Status Toast Notification Message -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="3" Width="8" Height="8" Background="{DynamicResource AccentEmeraldBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Git Version Info in bottom right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GitVersion}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
