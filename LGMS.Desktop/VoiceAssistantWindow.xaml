<Window x:Class="LGMS.Desktop.VoiceAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Voice Assistant Copilot — LGMS"
        Icon="app.ico"
        Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgDarkestBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderBrush="#06b6d4"
        BorderThickness="1"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif">

    <Window.Resources>
        <!-- Status to Brush Converter or DataTemplates -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title + Active Repo Dropdown + Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand Badge -->
            <Border Grid.Column="0" Background="#164e63" BorderBrush="#06b6d4" BorderThickness="1" CornerRadius="16" Padding="10,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="AI Voice Copilot" FontWeight="Bold" FontSize="12" Foreground="#38bdf8" VerticalAlignment="Center" />
                    <TextBlock Text="HUD" FontSize="10" Foreground="#bae6fd" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Active Repository Selector -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="Active Repo:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="RepoComboBox" Width="200" Padding="8,4" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="OnRepoSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="11" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock Text="{Binding CurrentBranch, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Sound Toggle & Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="MuteButton" Content="🔊 Sound On" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,8,0" Click="OnToggleMuteClicked" ToolTip="Toggle spoken audio replies" />
                <Button Content="✕" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Click="OnCloseClicked" ToolTip="Close (Esc)" />
            </StackPanel>
        </Grid>

        <!-- MAIN SCROLLABLE CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">

                <!-- Centerpiece: Pulsing Microphone Orb Button -->
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,16">
                    <Button x:Name="MicButton" Width="80" Height="80" Click="OnMicButtonClicked" Cursor="Hand" ToolTip="Click to speak (or press Space)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="OuterGlow" Fill="#0c4a6e" Stroke="#06b6d4" StrokeThickness="2" />
                                    <Ellipse x:Name="InnerCore" Fill="#0284c7" Margin="6" />
                                    <TextBlock x:Name="MicIcon" Text="🎤" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="InnerCore" Property="Fill" Value="#0ea5e9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="StatusLabelText" Text="Click microphone to speak or type command below" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,10,0,2" />
                    <TextBlock x:Name="ActiveRepoBanner" Text="Active: [No repository selected]" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Transcript / Command Input Card -->
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="SPEECH TRANSCRIPT &amp; COMMAND" FontSize="10" FontWeight="Bold" Foreground="#06b6d4" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TranscriptInput" Grid.Column="0" FontSize="13" Padding="10,8" Background="{DynamicResource BgInputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" KeyDown="OnTranscriptInputKeyDown" />
                            <Button Grid.Column="1" Content="⚡ Execute" Style="{DynamicResource PrimaryButton}" Margin="8,0,0,0" Padding="14,8" Click="OnExecuteClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- "Showing Working" Step Pipeline HUD -->
                <Border x:Name="WorkingSectionBorder" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚙️ EXECUTION PIPELINE ('SHOWING WORKING')" FontSize="10" FontWeight="Bold" Foreground="#a855f7" />
                        </StackPanel>

                        <!-- Steps Container -->
                        <ItemsControl x:Name="StepsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="●" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94a3b8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                <Setter Property="Foreground" Value="#10b981" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="running">
                                                                <Setter Property="Foreground" Value="#38bdf8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                <Setter Property="Foreground" Value="#ef4444" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#334155" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="completed">
                                                                <Setter Property="Background" Value="#064e3b" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="running">
                                                                <Setter Property="Background" Value="#075985" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="failed">
                                                                <Setter Property="Background" Value="#881337" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#ffffff" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Raw Output Expander -->
                        <Expander x:Name="RawOutputExpander" Header="View Raw Output" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBox x:Name="RawOutputText" IsReadOnly="True" Background="#050811" Foreground="#38bdf8" FontFamily="Consolas, monospace" FontSize="11" Padding="8" Margin="0,6,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Spoken AI Audio Response Card -->
                <Border x:Name="SpokenResponseCard" Background="#064e3b" BorderBrush="#10b981" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🔊 AI Spoken Response:" FontWeight="Bold" FontSize="11" Foreground="#a7f3d0" />
                        </StackPanel>
                        <TextBlock x:Name="SpokenResponseText" FontStyle="Italic" FontSize="12" Foreground="#ecfdf5" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Speakable Suggestions -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="💡 Try saying or clicking:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="💬 List all repositories" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="List all repositories" />
                        <Button Content="💬 Show status" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="Show status" />
                        <Button Content="💬 Pull latest changes" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="Pull latest changes" />
                        <Button Content="💬 Generate AI commit" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="Generate AI commit message" />
                        <Button Content="💬 Open in VS Code" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="Open in VS Code" />
                        <Button Content="💬 Open in Explorer" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6" Click="OnSuggestionClicked" Tag="Open in Explorer" />
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER: Hints -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <Grid>
                <TextBlock Text="🛡️ Sandboxed execution • Voice recognition &amp; text-to-speech powered by Windows Speech" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                <Button Content="Close" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="14,5" Click="OnCloseClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
