<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LGMS — Local Git Management System</title>
    <!-- Brand Favicon & Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="apple-touch-icon" href="~/images/logo.png" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- LGMS Themes and Styles -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dark.css" id="theme-dark-css" />
    <link rel="stylesheet" href="~/css/light.css" id="theme-light-css" disabled />
</head>
<body class="lgms-app">
    <!-- Reusable TopBar -->
    @await Html.PartialAsync("_TopBar")

    <div class="lgms-container">
        <!-- Reusable Sidebar -->
        @await Html.PartialAsync("_Sidebar")

        <!-- Main Workspace Viewport -->
        <main class="lgms-main" id="lgms-main-content">
            @RenderBody()
        </main>
    </div>

    <!-- Reusable Toast notifications -->
    @await Html.PartialAsync("_Toast")

    <!-- Reusable Loading overlay -->
    @await Html.PartialAsync("_LoadingOverlay")

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- LGMS Site JS -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
