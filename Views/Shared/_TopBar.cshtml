<header class="lgms-topbar">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-sm btn-icon text-muted d-lg-none" id="sidebar-toggle" title="Toggle Sidebar">
            <i class="bi bi-list fs-5"></i>
        </button>
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none lgms-brand">
            <img src="~/images/logo.png" alt="LGMS" class="brand-logo" style="width: 32px; height: 32px; border-radius: 8px; object-fit: contain; filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.4));" />
            <div class="brand-text">
                <span class="brand-title">LGMS</span>
                <span class="brand-subtitle d-none d-sm-inline">Local Git Management System</span>
            </div>
        </a>
    </div>

    <!-- Active Repository Pill -->
    <div class="lgms-active-repo d-none d-md-flex align-items-center gap-2" id="topbar-repo-info">
        @if (ViewBag.Repository != null)
        {
            var repo = (LGMS.Models.Repository)ViewBag.Repository;
            <span class="badge repo-pill"><i class="bi bi-folder2-open me-1"></i> @repo.Name</span>
            <span class="text-muted">/</span>
            <span class="badge branch-pill"><i class="bi bi-bezier2 me-1"></i> @repo.CurrentBranch</span>
            @if (!repo.IsClean)
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-circle-fill fs-xs me-1"></i> @repo.ChangesCount changes</span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i> clean</span>
            }
        }
    </div>

    <!-- Git Actions: Clone Repo & Add Project To GIT -->
    <div class="d-flex align-items-center gap-2 ms-auto ms-md-0">
        <button class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" onclick="LGMS.openCloneModal();" title="Clone a remote Git repository">
            <i class="bi bi-cloud-arrow-down"></i>
            <span class="d-none d-md-inline">Clone Repo</span>
        </button>
        <button class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" onclick="LGMS.openInitModal();" title="Initialize an existing folder as a Git repository">
            <i class="bi bi-plus-circle"></i>
            <span class="d-none d-md-inline">Add Project To GIT</span>
        </button>
        <button class="btn btn-sm btn-outline-info voice-topbar-btn d-inline-flex align-items-center gap-1" onclick="VoiceAssistant.toggleModal();" title="Open AI Voice Assistant HUD (Ctrl + Space)">
            <i class="bi bi-mic-fill text-cyan"></i>
            <span class="d-none d-sm-inline fw-semibold">Voice AI</span>
            <span class="badge bg-info-subtle text-info border border-info-subtle d-none d-lg-inline fs-xs">Ctrl+Space</span>
        </button>
    </div>

    <!-- Action Tools -->
    <div class="d-flex align-items-center gap-2">
        <a href="/docs" target="_blank" class="btn btn-sm btn-outline-info d-none d-md-inline-flex align-items-center gap-1" title="LGMS Showcase & Docs">
            <i class="bi bi-rocket-takeoff"></i>
            <span>Showcase &amp; Download</span>
        </a>
        <a href="/GitHub" class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1" title="GitHub Accounts & Integration">
            <i class="bi bi-github"></i>
            <span>GitHub</span>
        </a>
        <button class="btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1" id="btn-quick-refresh" onclick="location.reload();">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Refresh</span>
        </button>
        <button class="btn btn-sm btn-icon text-secondary" id="theme-toggle-btn" title="Toggle Light/Dark Theme" onclick="LGMS.toggleTheme();">
            <i class="bi bi-moon-stars" id="theme-icon"></i>
        </button>
        <a href="/settings" class="btn btn-sm btn-icon text-secondary" title="Settings">
            <i class="bi bi-gear"></i>
        </a>
    </div>
</header>
