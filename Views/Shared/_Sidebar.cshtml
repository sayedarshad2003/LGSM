@{
    var repo = ViewBag.Repository as LGMS.Models.Repository;
    var currentPath = Context.Request.Path.Value ?? "";
    string repoId = repo?.Id ?? "";
    string repoQuery = repo != null ? $"?path={Uri.EscapeDataString(repo.Path)}" : "";
}

<aside class="lgms-sidebar" id="lgms-sidebar">
    <div class="sidebar-section px-3 py-2 text-uppercase text-muted fw-bold fs-xs">
        Workspace
    </div>
    <ul class="nav flex-column sidebar-nav">
        <li class="nav-item">
            <a class="nav-link @(currentPath == "/" ? "active" : "")" href="/">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentPath.StartsWith("/repositories") ? "active" : "")" href="/repositories">
                <i class="bi bi-folder"></i>
                <span>Local Repositories</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-primary" href="javascript:void(0);" onclick="LGMS.openCloneModal();">
                <i class="bi bi-cloud-arrow-down text-primary"></i>
                <span>Clone Repo</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-success" href="javascript:void(0);" onclick="LGMS.openInitModal();">
                <i class="bi bi-plus-circle text-success"></i>
                <span>Add Project To GIT</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section px-3 py-2 text-uppercase text-muted fw-bold fs-xs mt-3">
        GitHub Integration
    </div>
    <ul class="nav flex-column sidebar-nav">
        <li class="nav-item">
            <a class="nav-link @(currentPath == "/GitHub" || currentPath == "/GitHub/Index" ? "active" : "")" href="/GitHub">
                <i class="bi bi-github"></i>
                <span>GitHub Accounts</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentPath.StartsWith("/GitHub/Repositories") ? "active" : "")" href="/GitHub/Repositories">
                <i class="bi bi-cloud-arrow-down"></i>
                <span>Remote Repos</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section px-3 py-2 text-uppercase text-muted fw-bold fs-xs mt-3">
        Repository Navigation
    </div>
    <ul class="nav flex-column sidebar-nav">
        @if (repo != null)
        {
            <li class="nav-item">
                <a class="nav-link @(currentPath == $"/repository/{repoId}" ? "active" : "")" href="/repository/@(repoId)@(repoQuery)">
                    <i class="bi bi-info-circle"></i>
                    <span>Overview</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/changes") ? "active" : "")" href="/repository/@(repoId)/changes@(repoQuery)">
                    <i class="bi bi-file-earmark-diff"></i>
                    <span>Changes</span>
                    @if (repo.ChangesCount > 0)
                    {
                        <span class="badge bg-danger ms-auto">@repo.ChangesCount</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/branches") ? "active" : "")" href="/repository/@(repoId)/branches@(repoQuery)">
                    <i class="bi bi-bezier2"></i>
                    <span>Branches</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/commits") ? "active" : "")" href="/repository/@(repoId)/commits@(repoQuery)">
                    <i class="bi bi-clock-history"></i>
                    <span>Commits</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/stashes") ? "active" : "")" href="/repository/@(repoId)/stashes@(repoQuery)">
                    <i class="bi bi-archive"></i>
                    <span>Stashes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/remotes") ? "active" : "")" href="/repository/@(repoId)/remotes@(repoQuery)">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <span>Remotes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentPath.Contains("/terminal") ? "active" : "")" href="/repository/@(repoId)/terminal@(repoQuery)">
                    <i class="bi bi-terminal"></i>
                    <span>Terminal</span>
                </a>
            </li>
        }
        else
        {
            <li class="nav-item px-3 py-2 text-muted fs-sm italic">
                <i class="bi bi-arrow-left-circle me-1"></i> Select a repository to unlock Git tools.
            </li>
        }
    </ul>

    <div class="mt-auto p-3 border-top sidebar-footer">
        <a class="nav-link p-0 text-muted d-flex align-items-center gap-2 @(currentPath.StartsWith("/settings") ? "text-primary fw-bold" : "")" href="/settings">
            <i class="bi bi-gear"></i>
            <span>Settings</span>
        </a>
    </div>
</aside>
