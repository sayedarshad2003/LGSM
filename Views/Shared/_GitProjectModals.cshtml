<!-- Global Modals for Clone Repo and Add Project To GIT -->

<!-- 1. Clone Repository Modal -->
<div class="modal fade" id="cloneRepoGlobalModal" tabindex="-1" aria-labelledby="cloneRepoGlobalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-card border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="icon-box bg-primary-subtle text-primary rounded p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-cloud-arrow-down fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="cloneRepoGlobalModalLabel">Clone Remote Repository</h5>
                        <span class="fs-xs text-muted">Clone any Git repository from GitHub, GitLab, or remote URL</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="cloneRepoForm" onsubmit="LGMS.submitCloneRepo(event)">
                    <!-- Step 1: Select Destination Folder First -->
                    <div class="mb-4">
                        <label for="cloneRepoDestInput" class="form-label fw-semibold d-flex justify-content-between align-items-center">
                            <span><span class="badge bg-primary me-2">Step 1</span> Select Destination Folder</span>
                            <span class="fs-xs text-muted">Folder must be empty or root folder</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-subtle border-end-0 text-muted">
                                <i class="bi bi-folder2-open"></i>
                            </span>
                            <input type="text" class="form-control font-monospace fs-sm border-start-0" id="cloneRepoDestInput" placeholder="e.g. C:\Projects or E:\Asp.NET Work\MyNewRepo" required />
                            <button class="btn btn-outline-primary d-flex align-items-center gap-2" type="button" id="btn-browse-clone-dest" onclick="LGMS.browseFolderForClone()">
                                <i class="bi bi-window-sidebar"></i> <span>Browse Folder</span>
                            </button>
                        </div>
                        <div class="form-text fs-xs text-muted mt-1">
                            <i class="bi bi-info-circle me-1"></i> Click <strong>Browse Folder</strong> to select the target directory via Windows File Explorer.
                        </div>
                    </div>

                    <!-- Step 2: Remote Repository URL -->
                    <div class="mb-3">
                        <label for="cloneRepoUrlInput" class="form-label fw-semibold">
                            <span class="badge bg-primary me-2">Step 2</span> Remote Repository URL
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-subtle border-end-0 text-muted">
                                <i class="bi bi-link-45deg"></i>
                            </span>
                            <input type="text" class="form-control font-monospace fs-sm border-start-0" id="cloneRepoUrlInput" placeholder="https://github.com/username/repository.git or git@github.com:..." required />
                        </div>
                        <div class="form-text fs-xs text-muted mt-1">
                            Supports HTTPS and SSH clone URLs.
                        </div>
                    </div>

                    <div id="cloneRepoErrorAlert" class="alert alert-danger fs-sm d-none mb-3" role="alert"></div>

                    <div class="modal-footer border-top px-0 pb-0 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" id="btn-submit-clone">
                            <i class="bi bi-cloud-arrow-down-fill"></i>
                            <span>Clone Repository</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 2. Add Project To GIT Modal -->
<div class="modal fade" id="initProjectGlobalModal" tabindex="-1" aria-labelledby="initProjectGlobalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-card border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="icon-box bg-success-subtle text-success rounded p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-plus-circle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="initProjectGlobalModalLabel">Add Project To GIT</h5>
                        <span class="fs-xs text-muted">Initialize any folder as a Git repository and create Initial Commit</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="initProjectForm" onsubmit="LGMS.submitInitProject(event)">
                    <!-- Select Folder -->
                    <div class="mb-4">
                        <label for="initProjectFolderInput" class="form-label fw-semibold">
                            Select Project Folder
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-subtle border-end-0 text-muted">
                                <i class="bi bi-folder-fill"></i>
                            </span>
                            <input type="text" class="form-control font-monospace fs-sm border-start-0" id="initProjectFolderInput" placeholder="Select or enter folder path to put into Git..." required />
                            <button class="btn btn-outline-success d-flex align-items-center gap-2" type="button" id="btn-browse-init-folder" onclick="LGMS.browseFolderForInit()">
                                <i class="bi bi-window-sidebar"></i> <span>Browse Folder</span>
                            </button>
                        </div>
                        <div class="form-text fs-xs text-muted mt-1">
                            <i class="bi bi-check-circle me-1"></i> LGMS will automatically run <code>git init</code>, stage all project files (<code>git add -A</code>), and commit with <strong>"Initial Commit"</strong>.
                        </div>
                    </div>

                    <!-- Commit Message -->
                    <div class="mb-3">
                        <label for="initProjectCommitMsg" class="form-label fw-semibold">Initial Commit Message</label>
                        <input type="text" class="form-control" id="initProjectCommitMsg" value="Initial Commit" />
                    </div>

                    <div id="initProjectErrorAlert" class="alert alert-danger fs-sm d-none mb-3" role="alert"></div>

                    <div class="modal-footer border-top px-0 pb-0 mt-4">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success d-flex align-items-center gap-2" id="btn-submit-init">
                            <i class="bi bi-git"></i>
                            <span>Initialize &amp; Commit</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
