<!-- LGMS AI Voice Command Assistant Screen / HUD -->
<div class="modal fade" id="voiceAssistantModal" tabindex="-1" aria-labelledby="voiceAssistantModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content voice-hud-content border-0 shadow-2xl">
            <!-- HUD Header -->
            <div class="modal-header border-bottom border-secondary-subtle py-3 px-4 d-flex align-items-center justify-content-between bg-dark-subtle">
                <div class="d-flex align-items-center gap-2">
                    <span class="voice-ai-chip">
                        <i class="bi bi-robot me-1 text-cyan"></i> AI Copilot
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs">
                        Voice HUD
                    </span>
                    <span class="badge bg-secondary-subtle text-muted fs-xs d-none d-sm-inline">
                        <kbd class="text-white bg-dark">Ctrl + Space</kbd>
                    </span>
                </div>

                <!-- Active Repo Selector & Sound Controls -->
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 260px;">
                        <span class="input-group-text bg-transparent border-secondary-subtle text-muted">
                            <i class="bi bi-folder2-open"></i>
                        </span>
                        <select id="voice-repo-select" class="form-select form-select-sm bg-dark text-white border-secondary-subtle" title="Active Repository Context">
                            <option value="">Loading repositories...</option>
                        </select>
                    </div>

                    <button class="btn btn-sm btn-icon btn-outline-secondary" id="voice-mute-btn" onclick="VoiceAssistant.toggleMute();" title="Toggle Audio Voice Reply">
                        <i class="bi bi-volume-up-fill text-info"></i>
                    </button>

                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="VoiceAssistant.stopListening(); VoiceAssistant.stopSpeaking();"></button>
                </div>
            </div>

            <!-- HUD Body -->
            <div class="modal-body p-4 voice-hud-body">
                <!-- Visualizer & Microphone Centerpiece -->
                <div class="text-center py-3 position-relative">
                    <!-- Audio Waveform Canvas -->
                    <canvas id="voice-wave-canvas" width="400" height="70" class="voice-wave-canvas mb-2"></canvas>

                    <!-- Futuristic Pulsing AI Orb -->
                    <div class="voice-orb-wrapper">
                        <div id="voice-ai-orb" class="voice-orb orb-idle" onclick="VoiceAssistant.toggleListening();" role="button" title="Click to start/stop listening">
                            <i class="bi bi-mic-fill fs-2"></i>
                        </div>
                    </div>

                    <!-- Live State Label -->
                    <div class="mt-3">
                        <h6 id="voice-status-label" class="fw-semibold text-white mb-1">
                            Click microphone or press Ctrl+Space to speak
                        </h6>
                        <span id="voice-active-repo-badge" class="badge bg-dark-subtle text-secondary border border-secondary-subtle fs-xs">
                            <i class="bi bi-folder text-muted me-1"></i> No repo selected
                        </span>
                    </div>
                </div>

                <!-- Live Speech-to-Text Card -->
                <div class="card bg-black-subtle border border-secondary-subtle p-3 mb-3 shadow-inner rounded-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted fs-xs text-uppercase fw-bold letter-spacing-1">
                            <i class="bi bi-soundwave text-cyan me-1"></i> Speech Transcript
                        </span>
                        <button class="btn btn-link btn-sm p-0 text-decoration-none fs-xs text-muted" onclick="document.getElementById('voice-transcript-text').textContent = '';">Clear</button>
                    </div>
                    <div id="voice-transcript-text" class="fs-6 text-white font-monospace text-wrap" style="min-height: 28px;">
                        <span class="text-muted">Say "Select repository [name]" or "In [name], show status"...</span>
                    </div>
                </div>

                <!-- "Showing Working" Step Pipeline HUD -->
                <div id="voice-working-section" class="mb-3 d-none">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted fs-xs text-uppercase fw-bold letter-spacing-1">
                            <i class="bi bi-gear-wide-connected text-primary me-1"></i> Execution Pipeline ("Showing Working")
                        </span>
                        <span class="badge bg-primary text-white fs-xs" id="voice-working-status-badge">Live Tracking</span>
                    </div>
                    <!-- Steps Container -->
                    <div id="voice-steps-container" class="voice-steps-box mb-2">
                        <!-- Dynamically populated by voice-assistant.js -->
                    </div>

                    <!-- Raw Terminal Output Accordion -->
                    <div id="voice-raw-output-drawer" class="d-none mt-2">
                        <details class="bg-black border border-secondary-subtle rounded p-2">
                            <summary class="text-muted fs-xs cursor-pointer user-select-none">
                                <i class="bi bi-terminal text-success me-1"></i> View Raw Command Output
                            </summary>
                            <pre id="voice-raw-output-content" class="text-light fs-xs font-monospace mt-2 mb-0 p-2 bg-dark rounded overflow-auto" style="max-height: 150px;"></pre>
                        </details>
                    </div>
                </div>

                <!-- Spoken AI Audio Response Display -->
                <div id="voice-spoken-reply" class="card bg-primary-subtle border border-primary-subtle p-3 mb-3 d-none rounded-3 shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary p-1 rounded-circle">
                            <i class="bi bi-volume-up-fill text-white fs-xs"></i>
                        </span>
                        <strong class="fs-sm text-primary">AI Audio Response:</strong>
                    </div>
                    <p id="voice-spoken-reply-text" class="mb-0 text-white fs-sm ps-4 fst-italic"></p>
                </div>

                <!-- Quick Speakable Suggestions -->
                <div>
                    <span class="text-muted fs-xs text-uppercase fw-bold d-block mb-2">
                        💡 Try saying or clicking:
                    </span>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('List all repositories');">
                            💬 "List all repositories"
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('Show status of current repository');">
                            💬 "Show status"
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('Pull latest changes');">
                            💬 "Pull latest"
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('Generate AI commit message');">
                            💬 "Generate AI commit"
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('Open in VS Code');">
                            💬 "Open in VS Code"
                        </button>
                        <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill" onclick="VoiceAssistant.submitQuickCommand('Open folder in explorer');">
                            💬 "Open folder"
                        </button>
                    </div>
                </div>
            </div>

            <!-- HUD Footer -->
            <div class="modal-footer border-top border-secondary-subtle py-2 px-4 bg-dark-subtle d-flex justify-content-between align-items-center">
                <div class="text-muted fs-xs">
                    <i class="bi bi-shield-check text-success me-1"></i> Sandboxed &amp; Safe execution gate
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" onclick="VoiceAssistant.toggleListening();">
                        <i class="bi bi-mic"></i> <span>Toggle Mic</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
