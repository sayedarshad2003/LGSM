    // ==========================================
    // 3. Page Selection & Tab Switching
    // ==========================================
    async function selectPageForInspection(filePath) {
        if (!currentCommitData) return;
        selectedFile = filePath;

        // Highlight selected item in list
        document.querySelectorAll('.file-item-row').forEach(el => {
            el.classList.toggle('active-file', el.getAttribute('data-file') === filePath);
        });

        // Load file content and diff for this page
        await loadPageData(filePath);
        renderActiveTab();
    }

    async function loadPageData(filePath) {
        try {
            const [diffRes, contentRes] = await Promise.all([
                fetch(`/api/git/commit/file-diff?path=${encodeURIComponent(repoPath)}&hash=${encodeURIComponent(currentCommitData.hash)}&file=${encodeURIComponent(filePath)}`),
                fetch(`/api/git/commit/file-content?path=${encodeURIComponent(repoPath)}&hash=${encodeURIComponent(currentCommitData.hash)}&file=${encodeURIComponent(filePath)}`)
            ]);

            const diffData = await diffRes.json();
            const contentData = await contentRes.json();

            currentFileContentData = {
                file: filePath,
                diff: diffData.diff || '',
                commitContent: contentData.commitContent || '',
                parentContent: contentData.parentContent || '',
                currentContent: contentData.currentContent || '',
                existsOnDisk: contentData.existsOnDisk || false
            };
        } catch (e) {
            console.error("Error fetching file details:", e);
        }
    }

    function switchInspectorTab(tab) {
        activeInspectorTab = tab;
        document.querySelectorAll('#inspectorTabList .nav-link').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.getElementById(`tab-btn-${tab}`);
        if (activeBtn) activeBtn.classList.add('active');

        renderActiveTab();
    }

    function renderActiveTab() {
        const viewport = document.getElementById('active-tab-viewport');
        if (!viewport) return;

        if (activeInspectorTab === 'compare') {
            renderSideBySideTab(viewport);
        } else if (activeInspectorTab === 'ide') {
            renderIdeTab(viewport);
        } else if (activeInspectorTab === 'unified') {
            renderUnifiedTab(viewport);
        } else if (activeInspectorTab === 'full') {
            renderFullCommitDiff();
        }
    }

    // ==========================================
    // 4. Tab 1: Side-by-Side Diff Compare
    // ==========================================
    let compareTargetMode = 'parent'; // 'parent' (Commit vs Previous) or 'working' (Commit vs Working Copy)

    function renderSideBySideTab(container) {
        if (!currentFileContentData || !selectedFile) {
            container.innerHTML = '<div class="text-center p-4 text-muted">No page selected to compare.</div>';
            return;
        }

        const shortHash = currentCommitData ? currentCommitData.hash.substring(0, 7) : 'Commit';
        const leftTitle = compareTargetMode === 'parent' ? `Parent Commit (Previous)` : `Commit ${shortHash}`;
        const rightTitle = compareTargetMode === 'parent' ? `Commit ${shortHash} (Selected)` : `Working Tree (On Disk)`;

        const splitRows = parseSideBySideDiff(currentFileContentData.diff);

        container.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted fs-xs fw-semibold text-uppercase">Comparing Page:</span>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace">${escapeHtml(selectedFile)}</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary py-0 px-2 fs-xs ${compareTargetMode === 'parent' ? 'active' : ''}" 
                                onclick="setCompareTarget('parent')">Commit vs Parent</button>
                        <button class="btn btn-outline-secondary py-0 px-2 fs-xs ${compareTargetMode === 'working' ? 'active' : ''}" 
                                onclick="setCompareTarget('working')">Commit vs Working Copy</button>
                    </div>
                </div>
            </div>

            <!-- Side by Side Split View Table -->
            <div class="diff-split-container">
                <div class="diff-split-scroll" id="diff-split-scroll-box">
                    <table class="diff-split-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;"><i class="bi bi-dash-circle text-danger me-1"></i> ${leftTitle}</th>
                                <th style="width: 50%;"><i class="bi bi-plus-circle text-success me-1"></i> ${rightTitle}</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${splitRows}
                        </tbody>
                    </table>
                </div>
            </div>
        `;
    }

    function setCompareTarget(mode) {
        compareTargetMode = mode;
        renderActiveTab();
    }

    function parseSideBySideDiff(diffText) {
        if (!diffText || diffText.trim().length === 0) {
            return '<tr><td colspan="2" class="p-4 text-center text-muted">No text changes recorded for this file (binary or unchanged).</td></tr>';
        }

        const lines = diffText.split('\n');
        let html = '';
        let leftLine = 0;
        let rightLine = 0;
        let pendingDeletions = [];
        let pendingAdditions = [];

        function flushPairs() {
            const maxLen = Math.max(pendingDeletions.length, pendingAdditions.length);
            for (let i = 0; i < maxLen; i++) {
                const del = pendingDeletions[i];
                const add = pendingAdditions[i];

                let leftNum = del ? del.num : '';
                let leftText = del ? escapeHtml(del.text) : '';
                let leftClass = del ? 'diff-col-del' : 'diff-col-empty';

                let rightNum = add ? add.num : '';
                let rightText = add ? escapeHtml(add.text) : '';
                let rightClass = add ? 'diff-col-add' : 'diff-col-empty';

                html += `
                    <tr>
                        <td class="${leftClass}">
                            <span class="diff-line-num d-inline-block">${leftNum}</span>
                            <span>${leftText}</span>
                        </td>
                        <td class="${rightClass}">
                            <span class="diff-line-num d-inline-block">${rightNum}</span>
                            <span>${rightText}</span>
                        </td>
                    </tr>
                `;
            }
            pendingDeletions = [];
            pendingAdditions = [];
        }

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];

            if (line.startsWith('diff --git') || line.startsWith('index ') || line.startsWith('---') || line.startsWith('+++')) {
                continue;
            }

            if (line.startsWith('@@')) {
                flushPairs();
                // Parse hunk header: @@ -l,s +r,s @@
                const match = line.match(/@@\s+-(\d+)(?:,\d+)?\s+\+(\d+)(?:,\d+)?\s+@@/);
                if (match) {
                    leftLine = parseInt(match[1], 10) - 1;
                    rightLine = parseInt(match[2], 10) - 1;
                }
                html += `<tr><td colspan="2" class="diff-hunk-row">${escapeHtml(line)}</td></tr>`;
                continue;
            }

            if (line.startsWith('-')) {
                leftLine++;
                pendingDeletions.push({ num: leftLine, text: line.substring(1) });
            } else if (line.startsWith('+')) {
                rightLine++;
                pendingAdditions.push({ num: rightLine, text: line.substring(1) });
            } else {
                flushPairs();
                leftLine++;
                rightLine++;
                const text = line.startsWith(' ') ? line.substring(1) : line;
                html += `
                    <tr>
                        <td><span class="diff-line-num d-inline-block">${leftLine}</span> <span>${escapeHtml(text)}</span></td>
                        <td><span class="diff-line-num d-inline-block">${rightLine}</span> <span>${escapeHtml(text)}</span></td>
                    </tr>
                `;
            }
        }
        flushPairs();
        return html;
    }

    // ==========================================
    // 5. Tab 2: Edit-Type IDE Viewer (Ctrl+F)
    // ==========================================
    function renderIdeTab(container) {
        if (!currentFileContentData || !selectedFile) {
            container.innerHTML = '<div class="text-center p-4 text-muted">No page selected to view in IDE.</div>';
            return;
        }

        const content = ideFindState.isEditMode ? (ideFindState.activeContent || currentFileContentData.currentContent || currentFileContentData.commitContent) : currentFileContentData.commitContent;
        ideFindState.activeContent = content;

        const lines = content.split('\n');
        const gutterHtml = lines.map((_, i) => `<div>${i + 1}</div>`).join('');
        const shortHash = currentCommitData ? currentCommitData.hash.substring(0, 7) : 'Commit';

        container.innerHTML = `
            <div class="ide-container-box" id="inpage-ide-container">
                <!-- Inpage IDE Toolbar -->
                <div class="ide-top-toolbar d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-code-slash text-primary"></i>
                        <span class="font-monospace fs-xs fw-bold">${escapeHtml(selectedFile)}</span>
                        <span class="badge bg-secondary-subtle text-secondary font-monospace fs-xs">${shortHash}</span>
                        <span class="badge ${ideFindState.isEditMode ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success'} fs-xs" id="inpage-ide-mode-badge">
                            ${ideFindState.isEditMode ? 'Edit Mode (Working Disk)' : 'Commit View Mode (Read-Only)'}
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Find Hotkey button -->
                        <button class="btn btn-xs btn-outline-info d-flex align-items-center gap-1" onclick="openIdeFindBar(false)" title="Search inside code (Ctrl + F)">
                            <i class="bi bi-search"></i> <span>Find</span>
                            <kbd class="fs-xs bg-dark text-muted border border-secondary px-1">Ctrl+F</kbd>
                        </button>
                        <!-- Toggle Edit Mode -->
                        <button class="btn btn-xs btn-outline-secondary d-flex align-items-center gap-1" onclick="toggleIdeEditMode(false)">
                            <i class="bi bi-pencil-square"></i>
                            <span id="inpage-toggle-edit-text">${ideFindState.isEditMode ? 'Switch to View' : 'Enable Edit'}</span>
                        </button>
                        <!-- Save Updates to Disk -->
                        <button class="btn btn-xs btn-primary d-flex align-items-center gap-1" id="inpage-btn-save" onclick="saveIdeUpdatedContent(false)" style="${ideFindState.isEditMode ? '' : 'display: none;'}">
                            <i class="bi bi-save"></i> <span>Save &amp; Update to Disk</span>
                        </button>
                    </div>
                </div>

                <!-- Floating Search Widget for in-page IDE -->
                <div id="inpage-ide-find-widget" class="ide-find-bar shadow rounded p-2" style="display: none;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="min-width: 200px;">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="inpage-find-input" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" placeholder="Find in code (Ctrl+F)..." oninput="runIdeSearch(this.value, false)" onkeydown="handleFindKeydown(event, false)">
                            <button class="btn btn-dark border-secondary text-muted" type="button" onclick="findNavigate(-1, false)" title="Previous Match (Shift+Enter)"><i class="bi bi-chevron-up"></i></button>
                            <button class="btn btn-dark border-secondary text-muted" type="button" onclick="findNavigate(1, false)" title="Next Match (Enter)"><i class="bi bi-chevron-down"></i></button>
                        </div>
                        <span class="badge bg-secondary font-monospace fs-xs" id="inpage-find-counter">0 of 0</span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-xs" id="inpage-match-case-btn" onclick="toggleFindCase(false)" title="Match Case">Aa</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-xs" id="inpage-match-word-btn" onclick="toggleFindWord(false)" title="Match Whole Word">\b</button>
                        <button class="btn btn-sm btn-icon text-muted" onclick="closeIdeFindBar(false)" title="Close (Esc)"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <!-- Replace Section in Edit Mode -->
                    <div id="inpage-replace-container" class="mt-2 pt-2 border-top border-secondary d-flex align-items-center gap-2" style="display: none;">
                        <div class="input-group input-group-sm" style="min-width: 200px;">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-pencil"></i></span>
                            <input type="text" id="inpage-replace-input" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" placeholder="Replace with...">
                        </div>
                        <button class="btn btn-sm btn-outline-warning py-0 px-2 fs-xs" onclick="replaceOneMatch(false)">Replace</button>
                        <button class="btn btn-sm btn-outline-warning py-0 px-2 fs-xs" onclick="replaceAllMatches(false)">Replace All</button>
                    </div>
                </div>

                <!-- Code Workspace -->
                <div class="d-flex" style="min-height: 400px; max-height: 540px; overflow: hidden; position: relative;">
                    <!-- Gutter -->
                    <div class="ide-gutter py-2 px-2 text-end font-monospace fs-xs border-end" id="inpage-ide-gutter">
                        ${gutterHtml}
                    </div>
                    <!-- Viewport -->
                    <div class="ide-code-viewport flex-grow-1 p-2 font-monospace fs-xs overflow-auto position-relative" id="inpage-ide-viewport" onscroll="syncInpageGutterScroll()">
                        <div id="inpage-ide-code-content" class="ide-code-lines" style="${ideFindState.isEditMode ? 'display: none;' : ''}">
                            ${renderCodeLinesHtml(content)}
                        </div>
                        <textarea id="inpage-ide-textarea" class="ide-code-textarea font-monospace fs-xs" spellcheck="false" 
                                  style="${ideFindState.isEditMode ? '' : 'display: none;'}" 
                                  oninput="onIdeTextareaInput(false)" onscroll="syncInpageTextareaGutter()">${escapeHtml(content)}</textarea>
                    </div>
                </div>

                <!-- Status Bar -->
                <div class="ide-top-toolbar py-1 px-3 d-flex justify-content-between align-items-center text-muted font-monospace fs-xs">
                    <div class="d-flex align-items-center gap-3">
                        <span><i class="bi bi-list-ol me-1"></i> ${lines.length} lines</span>
                        <span><i class="bi bi-fonts me-1"></i> ${content.length} chars</span>
                        <span>${getFileLanguage(selectedFile)}</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span>UTF-8</span>
                        <span>Commit ${shortHash}</span>
                    </div>
                </div>
            </div>
        `;
    }

    function renderCodeLinesHtml(content) {
        if (!content) return '<div class="p-3 text-muted">Empty file.</div>';
        const lines = content.split('\n');
        return lines.map((line, idx) => {
            return `<div class="ide-code-line" id="line-${idx}">${escapeHtml(line) || '&nbsp;'}</div>`;
        }).join('');
    }

    function toggleIdeEditMode(isModal) {
        ideFindState.isEditMode = !ideFindState.isEditMode;

        if (isModal) {
            const badge = document.getElementById('modal-ide-mode-badge');
            const toggleText = document.getElementById('modal-toggle-edit-text');
            const saveBtn = document.getElementById('modal-btn-save');
            const codeContent = document.getElementById('modal-ide-code-content');
            const textarea = document.getElementById('modal-ide-textarea');
            const replaceBox = document.getElementById('modal-replace-container');

            if (ideFindState.isEditMode) {
                badge.innerText = 'Edit Mode (Workspace)';
                badge.className = 'badge bg-warning-subtle text-warning fs-xs';
                toggleText.innerText = 'Switch to View Mode';
                saveBtn.style.display = '';
                codeContent.style.display = 'none';
                textarea.style.display = '';
                if (replaceBox) replaceBox.style.display = '';
                textarea.value = ideFindState.activeContent;
                textarea.focus();
            } else {
                badge.innerText = 'View Mode (Commit)';
                badge.className = 'badge bg-success-subtle text-success fs-xs';
                toggleText.innerText = 'Enable Edit Mode';
                saveBtn.style.display = 'none';
                textarea.style.display = 'none';
                codeContent.style.display = '';
                if (replaceBox) replaceBox.style.display = 'none';
                codeContent.innerHTML = renderCodeLinesHtml(ideFindState.activeContent);
            }
        } else {
            renderIdeTab(document.getElementById('active-tab-viewport'));
        }
    }

    function onIdeTextareaInput(isModal) {
        const textarea = document.getElementById(isModal ? 'modal-ide-textarea' : 'inpage-ide-textarea');
        if (!textarea) return;

        ideFindState.activeContent = textarea.value;
        const lineCount = textarea.value.split('\n').length;
        const gutter = document.getElementById(isModal ? 'modal-ide-gutter' : 'inpage-ide-gutter');
        if (gutter) {
            let html = '';
            for (let i = 1; i <= lineCount; i++) html += `<div>${i}</div>`;
            gutter.innerHTML = html;
        }

        if (isModal) {
            document.getElementById('modal-stat-lines').innerHTML = `<i class="bi bi-list-ol me-1"></i> ${lineCount} lines`;
            document.getElementById('modal-stat-chars').innerHTML = `<i class="bi bi-fonts me-1"></i> ${textarea.value.length} chars`;
        }
    }

    // ==========================================
    // 6. IDE Text Search (Ctrl + F)
    // ==========================================
    function openIdeFindBar(isModal) {
        ideFindState.isOpen = true;
        const widget = document.getElementById(isModal ? 'modal-ide-find-widget' : 'inpage-ide-find-widget');
        const input = document.getElementById(isModal ? 'modal-find-input' : 'inpage-find-input');
        if (widget && input) {
            widget.style.display = '';
            input.focus();
            input.select();
        }
    }

    function closeIdeFindBar(isModal) {
        ideFindState.isOpen = false;
        const widget = document.getElementById(isModal ? 'modal-ide-find-widget' : 'inpage-ide-find-widget');
        if (widget) widget.style.display = 'none';
        clearSearchHighlights(isModal);
    }

    function toggleFindCase(isModal) {
        ideFindState.matchCase = !ideFindState.matchCase;
        const btn = document.getElementById(isModal ? 'modal-match-case-btn' : 'inpage-match-case-btn');
        if (btn) btn.classList.toggle('active', ideFindState.matchCase);
        const input = document.getElementById(isModal ? 'modal-find-input' : 'inpage-find-input');
        if (input) runIdeSearch(input.value, isModal);
    }

    function toggleFindWord(isModal) {
        ideFindState.matchWord = !ideFindState.matchWord;
        const btn = document.getElementById(isModal ? 'modal-match-word-btn' : 'inpage-match-word-btn');
        if (btn) btn.classList.toggle('active', ideFindState.matchWord);
        const input = document.getElementById(isModal ? 'modal-find-input' : 'inpage-find-input');
        if (input) runIdeSearch(input.value, isModal);
    }

    function handleFindKeydown(e, isModal) {
        if (e.key === 'Enter') {
            e.preventDefault();
            findNavigate(e.shiftKey ? -1 : 1, isModal);
        } else if (e.key === 'Escape') {
            closeIdeFindBar(isModal);
        }
    }

    function runIdeSearch(query, isModal) {
        ideFindState.query = query;
        ideFindState.matches = [];
        ideFindState.currentIndex = -1;

        const counter = document.getElementById(isModal ? 'modal-find-counter' : 'inpage-find-counter');

        if (!query) {
            if (counter) counter.innerText = '0 of 0';
            clearSearchHighlights(isModal);
            return;
        }

        const content = ideFindState.activeContent || '';
        const lines = content.split('\n');

        let regex;
        try {
            let pattern = escapeRegExp(query);
            if (ideFindState.matchWord) pattern = `\\b${pattern}\\b`;
            regex = new RegExp(pattern, ideFindState.matchCase ? 'g' : 'gi');
        } catch (e) {
            return;
        }

        lines.forEach((line, lineIdx) => {
            let match;
            while ((match = regex.exec(line)) !== null) {
                ideFindState.matches.push({
                    lineIndex: lineIdx,
                    startIndex: match.index,
                    endIndex: match.index + match[0].length,
                    text: match[0]
                });
            }
        });

        if (counter) {
            counter.innerText = ideFindState.matches.length > 0 ? `1 of ${ideFindState.matches.length}` : '0 of 0';
        }

        if (ideFindState.matches.length > 0) {
            ideFindState.currentIndex = 0;
            highlightMatchesInIde(isModal);
            scrollToActiveMatch(isModal);
        } else {
            clearSearchHighlights(isModal);
        }
    }

    function findNavigate(direction, isModal) {
        if (ideFindState.matches.length === 0) return;

        ideFindState.currentIndex += direction;
        if (ideFindState.currentIndex >= ideFindState.matches.length) {
            ideFindState.currentIndex = 0;
        } else if (ideFindState.currentIndex < 0) {
            ideFindState.currentIndex = ideFindState.matches.length - 1;
        }

        const counter = document.getElementById(isModal ? 'modal-find-counter' : 'inpage-find-counter');
        if (counter) {
            counter.innerText = `${ideFindState.currentIndex + 1} of ${ideFindState.matches.length}`;
        }

        highlightMatchesInIde(isModal);
        scrollToActiveMatch(isModal);
    }

    function highlightMatchesInIde(isModal) {
        if (ideFindState.isEditMode) return; // In textarea mode, highlights are shown via find navigation

        const container = document.getElementById(isModal ? 'modal-ide-code-content' : 'inpage-ide-code-content');
        if (!container || !ideFindState.query) return;

        const content = ideFindState.activeContent || '';
        const lines = content.split('\n');
        let regex = new RegExp(escapeRegExp(ideFindState.query), ideFindState.matchCase ? 'g' : 'gi');

        let matchCounter = 0;
        const html = lines.map((line, lIdx) => {
            let highlighted = escapeHtml(line).replace(regex, (m) => {
                const isActive = matchCounter === ideFindState.currentIndex;
                matchCounter++;
                return `<mark class="ide-search-match ${isActive ? 'active-match' : ''}">${m}</mark>`;
            });
            return `<div class="ide-code-line" id="${isModal ? 'modal' : 'inpage'}-line-${lIdx}">${highlighted || '&nbsp;'}</div>`;
        }).join('');

        container.innerHTML = html;
    }

    function scrollToActiveMatch(isModal) {
        if (ideFindState.currentIndex < 0 || ideFindState.currentIndex >= ideFindState.matches.length) return;
        const current = ideFindState.matches[ideFindState.currentIndex];

        if (ideFindState.isEditMode) {
            const textarea = document.getElementById(isModal ? 'modal-ide-textarea' : 'inpage-ide-textarea');
            if (textarea) {
                // Calculate character offset of current match in textarea
                const lines = textarea.value.split('\n');
                let charOffset = 0;
                for (let i = 0; i < current.lineIndex; i++) {
                    charOffset += lines[i].length + 1;
                }
                charOffset += current.startIndex;
                textarea.focus();
                textarea.setSelectionRange(charOffset, charOffset + current.text.length);
            }
        } else {
            const lineEl = document.getElementById(`${isModal ? 'modal' : 'inpage'}-line-${current.lineIndex}`);
            if (lineEl) {
                lineEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    }

    function clearSearchHighlights(isModal) {
        if (!ideFindState.isEditMode) {
            const container = document.getElementById(isModal ? 'modal-ide-code-content' : 'inpage-ide-code-content');
            if (container) {
                container.innerHTML = renderCodeLinesHtml(ideFindState.activeContent);
            }
        }
    }

    // Replace Match logic for Edit Mode
    function replaceOneMatch(isModal) {
        if (!ideFindState.isEditMode || ideFindState.matches.length === 0 || ideFindState.currentIndex < 0) return;
        const replaceInput = document.getElementById(isModal ? 'modal-replace-input' : 'inpage-replace-input');
        const replaceVal = replaceInput ? replaceInput.value : '';

        const current = ideFindState.matches[ideFindState.currentIndex];
        const lines = ideFindState.activeContent.split('\n');
        const line = lines[current.lineIndex];

        lines[current.lineIndex] = line.substring(0, current.startIndex) + replaceVal + line.substring(current.endIndex);
        ideFindState.activeContent = lines.join('\n');

        const textarea = document.getElementById(isModal ? 'modal-ide-textarea' : 'inpage-ide-textarea');
        if (textarea) textarea.value = ideFindState.activeContent;

        runIdeSearch(ideFindState.query, isModal);
    }

    function replaceAllMatches(isModal) {
        if (!ideFindState.isEditMode || !ideFindState.query) return;
        const replaceInput = document.getElementById(isModal ? 'modal-replace-input' : 'inpage-replace-input');
        const replaceVal = replaceInput ? replaceInput.value : '';

        let pattern = escapeRegExp(ideFindState.query);
        if (ideFindState.matchWord) pattern = `\\b${pattern}\\b`;
        const regex = new RegExp(pattern, ideFindState.matchCase ? 'g' : 'gi');

        ideFindState.activeContent = ideFindState.activeContent.replace(regex, replaceVal);
        const textarea = document.getElementById(isModal ? 'modal-ide-textarea' : 'inpage-ide-textarea');
        if (textarea) textarea.value = ideFindState.activeContent;

        runIdeSearch(ideFindState.query, isModal);
        LGMS.toast("All matches replaced in editor", "info");
    }

    // ==========================================
    // 7. Check & Update It (Save Updated Code to Disk)
    // ==========================================
    async function saveIdeUpdatedContent(isModal) {
        if (!selectedFile) return;

        const contentToSave = ideFindState.activeContent;
        LGMS.showLoading(`Saving '${selectedFile}' to workspace disk...`, `Writing updated code to ${selectedFile}`);

        try {
            const res = await fetch('/api/git/commit/update-file', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    path: repoPath,
                    file: selectedFile,
                    content: contentToSave
                })
            });

            const data = await res.json();
            LGMS.hideLoading();

            if (data.success) {
                LGMS.toast(`✓ Page '${selectedFile}' updated successfully on disk!`, "success");
                // Reload diff and file data to sync compare view
                await loadPageData(selectedFile);
                if (!isModal && activeInspectorTab === 'compare') {
                    renderSideBySideTab(document.getElementById('active-tab-viewport'));
                }
            } else {
                LGMS.toast(data.error || "Failed to update file", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast(`Error updating file: ${e.message}`, "error");
        }
    }

    // ==========================================
    // 8. Fullscreen IDE Modal Controls
    // ==========================================
    function openFullscreenIde() {
        if (!selectedFile || !currentFileContentData) {
            LGMS.toast("Please select a page first", "warning");
            return;
        }

        const modalEl = document.getElementById('ideFullscreenModal');
        const modal = new bootstrap.Modal(modalEl);

        document.getElementById('modal-ide-filename').innerText = selectedFile;
        document.getElementById('modal-ide-commit-badge').innerText = currentCommitData.hash.substring(0, 7);

        const content = ideFindState.activeContent || currentFileContentData.commitContent;
        ideFindState.activeContent = content;

        const lines = content.split('\n');
        document.getElementById('modal-ide-gutter').innerHTML = lines.map((_, i) => `<div>${i + 1}</div>`).join('');
        document.getElementById('modal-ide-code-content').innerHTML = renderCodeLinesHtml(content);
        document.getElementById('modal-ide-textarea').value = content;

        document.getElementById('modal-stat-lines').innerHTML = `<i class="bi bi-list-ol me-1"></i> ${lines.length} lines`;
        document.getElementById('modal-stat-chars').innerHTML = `<i class="bi bi-fonts me-1"></i> ${content.length} chars`;
        document.getElementById('modal-stat-lang').innerHTML = `<i class="bi bi-file-earmark-code me-1"></i> ${getFileLanguage(selectedFile)}`;

        modal.show();
    }

    function openPageInIde(filePath) {
        selectPageForInspection(filePath).then(() => {
            switchInspectorTab('ide');
        });
    }

    function openSideBySideCompare(filePath) {
        selectPageForInspection(filePath).then(() => {
            switchInspectorTab('compare');
        });
    }

    // ==========================================
    // 9. Download Page Functionality
    // ==========================================
    function downloadCommitPage(hash, filePath) {
        const downloadUrl = `/api/git/commit/download-file?path=${encodeURIComponent(repoPath)}&hash=${encodeURIComponent(hash)}&file=${encodeURIComponent(filePath)}`;
        const a = document.createElement('a');
        a.href = downloadUrl;
        a.download = filePath.split('/').pop() || 'download';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        LGMS.toast(`Downloading '${filePath}' from commit ${hash.substring(0, 7)}...`, "info");
    }

    function downloadSelectedPage() {
        if (!selectedFile || !currentCommitData) {
            LGMS.toast("Select a page to download first", "warning");
            return;
        }
        downloadCommitPage(currentCommitData.hash, selectedFile);
    }

    function downloadCurrentIdeFile() {
        if (!selectedFile) return;
        const content = ideFindState.activeContent;
        const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = selectedFile.split('/').pop() || 'file.txt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        LGMS.toast(`Downloaded '${selectedFile}' from IDE editor`, "success");
    }

    // ==========================================
    // 10. Restore Page to Workspace Functionality
    // ==========================================
    async function restoreFile(hash, filePath) {
        const shortHash = hash.substring(0, 7);
        if (!confirm(`Are you sure you want to restore '${filePath}' from commit ${shortHash} into your working directory?\n\nThis will restore this page into your local repository workspace.`)) {
            return;
        }

        LGMS.showLoading(`Restoring ${filePath}...`, `git checkout ${shortHash} -- ${filePath}`);
        try {
            const res = await fetch('/api/git/commit/restore-file', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: repoPath, hash: hash, file: filePath })
            });
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ Page '${filePath}' restored from commit ${shortHash}!`, "success");
                // Reload diff data for active page
                await loadPageData(filePath);
                renderActiveTab();
            } else {
                LGMS.toast(data.message || "Failed to restore file", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast(`Error restoring file: ${e.message}`, "error");
        }
    }

    function restoreCurrentSelectedFile(hash) {
        if (!selectedFile) {
            LGMS.toast("Please select a file to restore first.", "warning");
            return;
        }
        restoreFile(hash, selectedFile);
    }

    function restoreCurrentIdeFile() {
        if (!selectedFile || !currentCommitData) return;
        restoreFile(currentCommitData.hash, selectedFile);
    }

    // Restore All Files from Commit
    async function restoreAllFromCommit(hash) {
        const shortHash = hash.substring(0, 7);
        if (!confirm(`Are you sure you want to restore ALL files from commit ${shortHash} into your working directory?\n\nThis will apply all changes from this commit into your system workspace.`)) {
            return;
        }

        LGMS.showLoading(`Restoring all changes from ${shortHash}...`, `git checkout ${shortHash} -- .`);
        try {
            const res = await fetch('/api/git/commit/restore-all', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: repoPath, hash: hash })
            });
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ All changes from commit ${shortHash} restored to system!`, "success");
                if (selectedFile) await loadPageData(selectedFile);
                renderActiveTab();
            } else {
                LGMS.toast(data.message || "Failed to restore commit changes", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast(`Error restoring commit: ${e.message}`, "error");
        }
    }

    // Revert Commit in Git
    async function revertCommit(hash) {
        const shortHash = hash.substring(0, 7);
        if (!confirm(`Are you sure you want to revert commit ${shortHash}?\n\nThis will create a new reverse commit to undo this commit.`)) {
            return;
        }

        LGMS.showLoading(`Reverting commit ${shortHash}...`, `git revert --no-edit ${shortHash}`);
        try {
            const res = await fetch('/api/git/commit/revert', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: repoPath, hash: hash })
            });
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ Commit ${shortHash} successfully reverted!`, "success");
                setTimeout(() => location.reload(), 1200);
            } else {
                LGMS.toast(data.message || "Failed to revert commit", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast(`Error reverting commit: ${e.message}`, "error");
        }
    }

    // ==========================================
    // 11. Tab 3 & 4: Unified & Full Commit Diff
    // ==========================================
    function renderUnifiedTab(container) {
        const diffText = currentFileContentData ? currentFileContentData.diff : (currentCommitData ? currentCommitData.diff : '');
        container.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fs-xs fw-semibold text-uppercase">Unified Diff: ${escapeHtml(selectedFile || 'Selected File')}</span>
            </div>
            <div class="diff-unified-box">
                ${formatUnifiedDiffHtml(diffText || "No diff found.")}
            </div>
        `;
    }

    function renderFullCommitDiff() {
        const container = document.getElementById('active-tab-viewport');
        if (!container || !currentCommitData) return;
        container.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted fs-xs fw-semibold text-uppercase">Full Commit Patch (${currentCommitData.hash.substring(0, 7)})</span>
            </div>
            <div class="diff-unified-box">
                ${formatUnifiedDiffHtml(currentCommitData.diff || "No diff found for this commit.")}
            </div>
        `;
    }

    function formatUnifiedDiffHtml(diffText) {
        if (!diffText) return 'No diff content.';
        const lines = diffText.split('\n');
        return lines.map(line => {
            const escaped = escapeHtml(line);
            if (line.startsWith('+') && !line.startsWith('+++')) {
                return `<span class="diff-line-add">${escaped}</span>`;
            } else if (line.startsWith('-') && !line.startsWith('---')) {
                return `<span class="diff-line-del">${escaped}</span>`;
            } else if (line.startsWith('@@') || line.startsWith('diff --git')) {
                return `<span class="diff-line-meta">${escaped}</span>`;
            }
            return `<span>${escaped}</span>`;
        }).join('');
    }

    // ==========================================
    // 12. Helper Utilities
    // ==========================================
    function syncInpageGutterScroll() {
        const vp = document.getElementById('inpage-ide-viewport');
        const gutter = document.getElementById('inpage-ide-gutter');
        if (vp && gutter) gutter.scrollTop = vp.scrollTop;
    }

    function syncInpageTextareaGutter() {
        const ta = document.getElementById('inpage-ide-textarea');
        const gutter = document.getElementById('inpage-ide-gutter');
        if (ta && gutter) gutter.scrollTop = ta.scrollTop;
    }

    function syncModalGutterScroll() {
        const vp = document.getElementById('modal-ide-viewport');
        const gutter = document.getElementById('modal-ide-gutter');
        if (vp && gutter) gutter.scrollTop = vp.scrollTop;
    }

    function syncModalTextareaGutter() {
        const ta = document.getElementById('modal-ide-textarea');
        const gutter = document.getElementById('modal-ide-gutter');
        if (ta && gutter) gutter.scrollTop = ta.scrollTop;
    }

    function getStatusBadge(code) {
        const c = (code || 'M').toUpperCase();
        if (c.startsWith('A')) return '<span class="badge bg-success-subtle text-success font-monospace py-0 px-1">ADD</span>';
        if (c.startsWith('D')) return '<span class="badge bg-danger-subtle text-danger font-monospace py-0 px-1">DEL</span>';
        if (c.startsWith('R')) return '<span class="badge bg-info-subtle text-info font-monospace py-0 px-1">REN</span>';
        return '<span class="badge bg-warning-subtle text-warning font-monospace py-0 px-1">MOD</span>';
    }

    function getFileIcon(filePath) {
        if (!filePath) return 'bi bi-file-earmark';
        const ext = filePath.split('.').pop().toLowerCase();
        switch (ext) {
            case 'cs': return 'bi bi-file-earmark-code text-primary';
            case 'cshtml': return 'bi bi-file-earmark-richtext text-danger';
            case 'js': case 'ts': return 'bi bi-filetype-js text-warning';
            case 'css': case 'scss': return 'bi bi-filetype-css text-info';
            case 'html': return 'bi bi-filetype-html text-danger';
            case 'json': return 'bi bi-filetype-json text-warning';
            case 'md': return 'bi bi-filetype-md text-info';
            case 'xml': case 'config': return 'bi bi-filetype-xml text-success';
            default: return 'bi bi-file-earmark-text text-secondary';
        }
    }

    function getFileLanguage(filePath) {
        if (!filePath) return 'Plain Text';
        const ext = filePath.split('.').pop().toLowerCase();
        switch (ext) {
            case 'cs': return 'C# (.NET)';
            case 'cshtml': return 'Razor CSHTML';
            case 'js': return 'JavaScript';
            case 'ts': return 'TypeScript';
            case 'css': return 'CSS';
            case 'html': return 'HTML5';
            case 'json': return 'JSON';
            case 'md': return 'Markdown';
            case 'xml': return 'XML / Config';
            default: return 'Text';
        }
    }

    function escapeHtml(s) {
        if (!s) return '';
        return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    async function branchFromCommit(hash) {
        const branchName = prompt("Enter new branch name:", "branch-" + hash.substring(0, 7));
        if (branchName) {
            LGMS.showLoading(`Creating branch ${branchName}...`, "git checkout -b");
            try {
                const res = await fetch('/api/git/branch/create', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ path: repoPath, branch: branchName })
                });
                const data = await res.json();
                LGMS.hideLoading();
                if (data.success) {
                    LGMS.toast(`✓ Branch ${branchName} created`, "success");
                    location.href = `/repository/${repoId}/branches?path=${encodeURIComponent(repoPath)}`;
                } else {
                    LGMS.toast(data.error || "Branch creation failed", "error");
                }
            } catch (e) {
                LGMS.hideLoading();
                LGMS.toast("Failed to create branch", "error");
            }
        }
    }
</script>
}
