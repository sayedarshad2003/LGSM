@model List<LGMS.Models.GitCommit>
@{
    var repo = (LGMS.Models.Repository)ViewBag.Repository;
    ViewData["Title"] = $"{repo.Name} — Commits & History";
}

<div class="container-fluid py-4 lgms-commit-section">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/repository/@repo.Id?path=@Uri.EscapeDataString(repo.Path)" class="text-muted text-decoration-none">
                    <i class="bi bi-folder2-open me-1"></i> @repo.Name
                </a>
                <span class="text-muted">/</span>
                <span class="badge branch-pill"><i class="bi bi-bezier2 me-1"></i> @repo.CurrentBranch</span>
            </div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-clock-history me-2 text-primary"></i> History &amp; Commits
            </h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/repository/@repo.Id?path=@Uri.EscapeDataString(repo.Path)" class="btn btn-outline-secondary d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> <span>Dashboard</span>
            </a>
            <button class="btn btn-outline-secondary d-flex align-items-center gap-1" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise"></i> <span>Refresh</span>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Commits List Column -->
        <div class="col-12 col-xl-4 col-lg-5">
            <div class="card border-0 shadow-sm bg-card h-100">
                <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-list-nested me-2 text-primary"></i> Commits Log (@Model.Count)
                    </h5>
                    <span class="text-muted fs-xs">Select to view pages</span>
                </div>
                <!-- Search Commits Filter -->
                <div class="p-2 border-bottom bg-subtle">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-transparent border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="commit-search-input" class="form-control form-control-sm border-start-0" 
                               placeholder="Filter commits by message, author, or hash..." oninput="filterCommitsList()">
                        <button class="btn btn-outline-secondary" type="button" onclick="clearCommitSearch()" title="Clear filter">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="list-group list-group-flush" id="commit-list-group" style="max-height: 820px; overflow-y: auto;">
                            @foreach (var commit in Model)
                            {
                                <button type="button" class="list-group-item list-group-item-action p-3 text-start commit-item-btn border-start-0 border-end-0" 
                                        data-hash="@commit.Hash" 
                                        data-search="@($"{commit.Hash} {commit.ShortHash} {commit.Subject} {commit.AuthorName}".ToLowerInvariant())"
                                        onclick="inspectCommit('@commit.Hash')">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@commit.ShortHash</span>
                                        <span class="text-muted fs-xs"><i class="bi bi-clock me-1"></i>@commit.RelativeTime</span>
                                    </div>
                                    <div class="fw-semibold text-primary mb-1 text-truncate commit-subject">@commit.Subject</div>
                                    <div class="text-muted fs-xs d-flex align-items-center justify-content-between">
                                        <span><i class="bi bi-person me-1"></i> @commit.AuthorName</span>
                                        <span class="text-muted font-monospace">@commit.Date.ToString("yyyy-MM-dd HH:mm")</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-clock fs-1 mb-2 d-block text-secondary"></i>
                            No commits recorded in this repository yet.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Commit Details, Page-wise Changes, IDE & Diff Compare Column -->
        <div class="col-12 col-xl-8 col-lg-7">
            <div class="card border-0 shadow-sm bg-card" id="commit-inspector-card">
                <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-semibold mb-0" id="inspector-title">
                        <i class="bi bi-layers me-2 text-primary"></i> Commit Inspector
                    </h5>
                    <span class="badge bg-info-subtle text-info fs-xs" id="inspector-status-badge">Select a commit</span>
                </div>
                <div class="card-body p-3 p-md-4" id="inspector-body">
                    <div class="text-center text-muted p-5">
                        <i class="bi bi-cursor text-muted fs-1 mb-3 d-block"></i>
                        <h5>No Commit Selected</h5>
                        <p class="fs-sm mb-0">Select any commit on the left to see that commit's pages. From there you can download files, view and edit them in an IDE with <code>Ctrl + F</code> search, restore specific pages, and compare changes side-by-side.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= FULLSCREEN IDE MODAL ================= -->
<div class="modal fade" id="ideFullscreenModal" tabindex="-1" aria-labelledby="ideModalTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark text-light border-0">
            <!-- Modal IDE Header -->
            <div class="modal-header bg-dark border-bottom border-secondary py-2 px-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 text-truncate">
                    <i class="bi bi-code-square text-primary fs-5"></i>
                    <span class="fw-bold fs-6 font-monospace" id="modal-ide-filename">File Viewer</span>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace fs-xs" id="modal-ide-commit-badge">Commit</span>
                    <span class="badge bg-success-subtle text-success fs-xs" id="modal-ide-mode-badge">View Mode</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" id="modal-btn-find" onclick="openIdeFindBar(true)" title="Search Text (Ctrl+F)">
                        <i class="bi bi-search"></i>
                        <span class="d-none d-sm-inline">Find</span>
                        <kbd class="fs-xs bg-dark text-muted border border-secondary px-1">Ctrl+F</kbd>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" id="modal-btn-toggle-edit" onclick="toggleIdeEditMode(true)">
                        <i class="bi bi-pencil-square"></i>
                        <span id="modal-toggle-edit-text">Enable Edit Mode</span>
                    </button>
                    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="modal-btn-save" onclick="saveIdeUpdatedContent(true)" style="display: none;">
                        <i class="bi bi-save me-1"></i> <span>Save &amp; Update to Disk</span>
                    </button>
                    <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1" onclick="downloadCurrentIdeFile()">
                        <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Download</span>
                    </button>
                    <button class="btn btn-sm btn-outline-warning d-flex align-items-center gap-1" onclick="restoreCurrentIdeFile()">
                        <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline">Restore to System</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <!-- Modal IDE Body -->
            <div class="modal-body p-0 position-relative d-flex flex-column" style="height: calc(100vh - 90px); background: #14161b;">
                <!-- Floating IDE Search Widget for Modal -->
                <div id="modal-ide-find-widget" class="ide-find-bar shadow-lg border border-secondary rounded p-2" style="display: none;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group input-group-sm" style="min-width: 220px;">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" id="modal-find-input" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" placeholder="Find in code (Ctrl+F)..." oninput="runIdeSearch(this.value, true)" onkeydown="handleFindKeydown(event, true)">
                            <button class="btn btn-dark border-secondary text-muted" type="button" onclick="findNavigate(-1, true)" title="Previous Match (Shift+Enter)"><i class="bi bi-chevron-up"></i></button>
                            <button class="btn btn-dark border-secondary text-muted" type="button" onclick="findNavigate(1, true)" title="Next Match (Enter)"><i class="bi bi-chevron-down"></i></button>
                        </div>
                        <span class="badge bg-secondary font-monospace fs-xs" id="modal-find-counter">0 of 0</span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-xs" id="modal-match-case-btn" onclick="toggleFindCase(true)" title="Match Case">Aa</button>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-xs" id="modal-match-word-btn" onclick="toggleFindWord(true)" title="Match Whole Word">\b</button>
                        <button class="btn btn-sm btn-icon text-muted" onclick="closeIdeFindBar(true)" title="Close (Esc)"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <!-- Replace Section (Visible in Edit Mode) -->
                    <div id="modal-replace-container" class="mt-2 pt-2 border-top border-secondary d-flex align-items-center gap-2" style="display: none;">
                        <div class="input-group input-group-sm" style="min-width: 220px;">
                            <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-pencil"></i></span>
                            <input type="text" id="modal-replace-input" class="form-control form-control-sm bg-dark text-light border-secondary font-monospace" placeholder="Replace with...">
                        </div>
                        <button class="btn btn-sm btn-outline-warning py-0 px-2 fs-xs" onclick="replaceOneMatch(true)">Replace</button>
                        <button class="btn btn-sm btn-outline-warning py-0 px-2 fs-xs" onclick="replaceAllMatches(true)">Replace All</button>
                    </div>
                </div>

                <!-- Modal IDE Editor Container -->
                <div class="d-flex flex-grow-1 overflow-hidden" id="modal-ide-container">
                    <!-- Gutter / Line Numbers -->
                    <div class="ide-gutter py-2 px-2 text-end user-select-none font-monospace fs-xs border-end border-secondary" id="modal-ide-gutter">
                        1
                    </div>
                    <!-- Code Viewport -->
                    <div class="ide-code-viewport flex-grow-1 p-2 font-monospace fs-xs overflow-auto position-relative" id="modal-ide-viewport" onscroll="syncModalGutterScroll()">
                        <div id="modal-ide-code-content" class="ide-code-lines"></div>
                        <textarea id="modal-ide-textarea" class="ide-code-textarea font-monospace fs-xs" spellcheck="false" style="display: none;" oninput="onIdeTextareaInput(true)" onscroll="syncModalTextareaGutter()"></textarea>
                    </div>
                </div>

                <!-- Modal IDE Status Bar -->
                <div class="ide-status-bar bg-dark border-top border-secondary py-1 px-3 d-flex justify-content-between align-items-center text-muted font-monospace fs-xs">
                    <div class="d-flex align-items-center gap-3">
                        <span id="modal-stat-lines"><i class="bi bi-list-ol me-1"></i> 0 lines</span>
                        <span id="modal-stat-chars"><i class="bi bi-fonts me-1"></i> 0 chars</span>
                        <span id="modal-stat-lang"><i class="bi bi-file-earmark-code me-1"></i> PlainText</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span>UTF-8</span>
                        <span id="modal-stat-version">Commit Version</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Section styling */
    .lgms-commit-section {
        min-height: calc(100vh - 120px);
    }
    .commit-item-btn {
        transition: all 0.18s ease-in-out;
    }
    .commit-item-btn:hover {
        background-color: var(--bs-primary-bg-subtle, rgba(13, 110, 253, 0.05));
    }
    .commit-item-btn.active-commit {
        background-color: var(--bs-primary-bg-subtle, rgba(13, 110, 253, 0.12)) !important;
        border-left: 4px solid var(--bs-primary, #0d6efd) !important;
    }
    .file-item-row {
        transition: all 0.15s ease-in-out;
    }
    .file-item-row:hover {
        background-color: rgba(255, 255, 255, 0.04);
    }
    .file-item-row.active-file {
        background-color: var(--bs-primary-bg-subtle, rgba(13, 110, 253, 0.12)) !important;
        border-left: 3px solid var(--bs-primary, #0d6efd) !important;
    }

    /* Embedded IDE Styles */
    .ide-container-box {
        background: #12141a;
        color: #d8dee9;
        border: 1px solid var(--lgms-border, #2a2f3a);
        border-radius: 8px;
        overflow: hidden;
        position: relative;
    }
    .ide-top-toolbar {
        background: #1a1e27;
        border-bottom: 1px solid var(--lgms-border, #2a2f3a);
        padding: 8px 12px;
    }
    .ide-gutter {
        background: #141720;
        color: #5c6370;
        min-width: 48px;
        line-height: 1.6;
        user-select: none;
        overflow: hidden;
    }
    .ide-code-viewport {
        background: #12141a;
        line-height: 1.6;
        white-space: pre;
        tab-size: 4;
        min-height: 380px;
        max-height: 540px;
    }
    .ide-code-lines {
        color: #e5e7eb;
        font-family: 'Cascadia Code', 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    }
    .ide-code-line {
        min-height: 1.6em;
        padding: 0 4px;
    }
    .ide-code-line:hover {
        background: rgba(255, 255, 255, 0.03);
    }
    .ide-code-textarea {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        color: #e5e7eb;
        border: none;
        outline: none;
        resize: none;
        padding: 8px;
        line-height: 1.6;
        tab-size: 4;
        white-space: pre;
    }

    /* Search Bar Floating Widget */
    .ide-find-bar {
        position: absolute;
        top: 10px;
        right: 20px;
        z-index: 1050;
        background: #1f232d !important;
        border: 1px solid #3b4252 !important;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
    }
    .ide-search-match {
        background-color: #f59e0b;
        color: #000;
        font-weight: bold;
        border-radius: 2px;
        padding: 0 1px;
    }
    .ide-search-match.active-match {
        background-color: #38bdf8;
        color: #000;
        outline: 2px solid #0284c7;
    }

    /* Side-by-Side Diff Table */
    .diff-split-container {
        font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
        font-size: 12px;
        line-height: 1.5;
        background: #111318;
        color: #e4e4e7;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--lgms-border, #2a2f3a);
    }
    .diff-split-scroll {
        max-height: 480px;
        overflow: auto;
    }
    .diff-split-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }
    .diff-split-table th {
        background: #181c25;
        color: #9ca3af;
        padding: 6px 10px;
        font-size: 11px;
        text-transform: uppercase;
        border-bottom: 1px solid var(--lgms-border, #2a2f3a);
    }
    .diff-split-table td {
        padding: 1px 8px;
        vertical-align: top;
        white-space: pre-wrap;
        word-break: break-all;
    }
    .diff-line-num {
        width: 44px;
        min-width: 44px;
        text-align: right;
        color: #4b5563;
        user-select: none;
        padding-right: 6px !important;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        background: rgba(0, 0, 0, 0.2);
    }
    .diff-col-del {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
    }
    .diff-col-del .diff-line-num {
        color: #f87171;
        background: rgba(239, 68, 68, 0.18);
    }
    .diff-col-add {
        background: rgba(34, 197, 94, 0.12);
        color: #86efac;
    }
    .diff-col-add .diff-line-num {
        color: #4ade80;
        background: rgba(34, 197, 94, 0.18);
    }
    .diff-col-empty {
        background: rgba(255, 255, 255, 0.015);
        color: transparent;
    }
    .diff-hunk-row {
        background: #1e2430;
        color: #60a5fa;
        font-weight: bold;
        padding: 4px 10px;
        border-top: 1px solid #2a3344;
        border-bottom: 1px solid #2a3344;
    }

    /* Unified Diff Box */
    .diff-unified-box {
        font-family: 'Cascadia Code', 'JetBrains Mono', 'Consolas', monospace;
        font-size: 12px;
        line-height: 1.5;
        background: #111318;
        color: #e4e4e7;
        border-radius: 6px;
        padding: 12px;
        max-height: 480px;
        overflow: auto;
        white-space: pre-wrap;
    }
    .diff-line-add {
        color: #4ade80;
        background-color: rgba(74, 222, 128, 0.12);
        display: block;
    }
    .diff-line-del {
        color: #f87171;
        background-color: rgba(248, 113, 113, 0.12);
        display: block;
    }
    .diff-line-meta {
        color: #60a5fa;
        display: block;
        font-weight: bold;
    }
</style>

@section Scripts {
<script>
    const repoPath = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(repo.Path));
    const repoId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(repo.Id));
    let currentCommitData = null;
    let selectedFile = null;
    let currentFileContentData = null;
    let activeInspectorTab = 'compare'; // 'compare', 'ide', 'unified', 'full'

    // State for IDE Find & Replace
    let ideFindState = {
        isOpen: false,
        query: '',
        matches: [],
        currentIndex: -1,
        matchCase: false,
        matchWord: false,
        isEditMode: false,
        activeContent: ''
    };

    // Auto-inspect first commit if present
    document.addEventListener("DOMContentLoaded", function () {
        const firstBtn = document.querySelector(".commit-item-btn");
        if (firstBtn) {
            const hash = firstBtn.getAttribute("data-hash");
            if (hash) inspectCommit(hash);
        }

        // Global hotkey Ctrl+F / Cmd+F handler
        window.addEventListener("keydown", function (e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'f' || e.key === 'F')) {
                // If user is inside commit page, trigger Find bar
                const modal = document.getElementById('ideFullscreenModal');
                const isModalOpen = modal && modal.classList.contains('show');
                if (isModalOpen) {
                    e.preventDefault();
                    openIdeFindBar(true);
                } else if (activeInspectorTab === 'ide' || document.getElementById('inpage-ide-container')) {
                    e.preventDefault();
                    openIdeFindBar(false);
                }
            } else if (e.key === 'Escape') {
                closeIdeFindBar(false);
                closeIdeFindBar(true);
            }
        });
    });

    // ==========================================
    // 1. Commit Log & Filtering
    // ==========================================
    function filterCommitsList() {
        const term = (document.getElementById('commit-search-input')?.value || '').toLowerCase().trim();
        const items = document.querySelectorAll('.commit-item-btn');
        items.forEach(item => {
            const searchData = item.getAttribute('data-search') || '';
            item.style.display = (!term || searchData.includes(term)) ? '' : 'none';
        });
    }

    function clearCommitSearch() {
        const input = document.getElementById('commit-search-input');
        if (input) {
            input.value = '';
            filterCommitsList();
        }
    }

    // ==========================================
    // 2. Commit Inspector & Page List
    // ==========================================
    async function inspectCommit(hash) {
        document.querySelectorAll('.commit-item-btn').forEach(btn => {
            btn.classList.toggle('active-commit', btn.getAttribute('data-hash') === hash);
        });

        const body = document.getElementById('inspector-body');
        const badge = document.getElementById('inspector-status-badge');
        badge.innerText = 'Loading...';
        badge.className = 'badge bg-warning-subtle text-warning fs-xs';
        body.innerHTML = `
            <div class="text-center p-5 text-muted">
                <div class="spinner-border text-primary spinner-border-sm me-2"></div>
                Loading commit pages, file contents &amp; diff...
            </div>
        `;

        try {
            const res = await fetch(`/api/git/commit/details?path=${encodeURIComponent(repoPath)}&hash=${encodeURIComponent(hash)}`);
            const data = await res.json();
            if (!data.success) {
                badge.innerText = 'Error';
                badge.className = 'badge bg-danger-subtle text-danger fs-xs';
                body.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle me-2"></i> Failed to inspect commit: ${data.error || 'Unknown error'}</div>`;
                return;
            }

            currentCommitData = data;
            selectedFile = null;
            badge.innerText = `${data.filesCount || 0} page(s) in this commit`;
            badge.className = 'badge bg-success-subtle text-success fs-xs';

            renderCommitInspector(data);
        } catch (e) {
            badge.innerText = 'Network Error';
            badge.className = 'badge bg-danger-subtle text-danger fs-xs';
            body.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-wifi-off me-2"></i> Network error fetching commit details: ${e.message}</div>`;
        }
    }

    function renderCommitInspector(data) {
        const body = document.getElementById('inspector-body');
        const shortHash = data.hash.substring(0, 7);

        // Build Changed Files / Pages list HTML
        let filesListHtml = '';
        if (data.changedFiles && data.changedFiles.length > 0) {
            filesListHtml = data.changedFiles.map((f, idx) => {
                const statusBadge = getStatusBadge(f.statusCode || 'M');
                const fileIcon = getFileIcon(f.path);
                const statStr = (f.additions || f.deletions) 
                    ? `<span class="badge bg-success-subtle text-success py-0 px-1 font-monospace">+${f.additions || 0}</span> <span class="badge bg-danger-subtle text-danger py-0 px-1 font-monospace">-${f.deletions || 0}</span>` 
                    : '';
                const activeClass = idx === 0 ? 'active-file' : '';
                return `
                    <div class="list-group-item list-group-item-action d-flex flex-column flex-md-row justify-content-between align-items-md-center p-2 file-item-row ${activeClass}" 
                         data-file="${escapeHtml(f.path)}" 
                         onclick="selectPageForInspection('${escapeHtml(f.path)}')">
                        <div class="d-flex align-items-center gap-2 text-truncate mb-2 mb-md-0" style="cursor: pointer; flex: 1;">
                            ${statusBadge}
                            <i class="${fileIcon} text-muted"></i>
                            <span class="font-monospace fs-xs text-truncate fw-semibold" title="${escapeHtml(f.path)}">${escapeHtml(f.path)}</span>
                        </div>
                        <div class="d-flex align-items-center gap-1 ms-md-2 flex-wrap">
                            ${statStr}
                            <!-- Download Page -->
                            <button class="btn btn-xs btn-outline-info py-0 px-2 fs-xs d-flex align-items-center gap-1" 
