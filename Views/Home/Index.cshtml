@model LGMS.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Welcome to LGMS";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- Setup / Welcome Banner -->
            <div class="card p-4 mb-4 border-0 shadow-sm bg-card">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-primary text-uppercase px-2 py-1 fs-xs">Local First</span>
                            <span class="text-muted fs-sm">ASP.NET Core MVC .NET 9</span>
                        </div>
                        <h2 class="fw-bold mb-1">LGMS — Local Git Management System</h2>
                        <p class="text-muted mb-0">Select your Git workspace folder to automatically discover and manage local repositories.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary d-flex align-items-center gap-2" onclick="promptWorkspaceFolder()">
                            <i class="bi bi-folder2-open"></i> Change Folder
                        </button>
                        <button class="btn btn-primary d-flex align-items-center gap-2" id="btn-scan" onclick="triggerScan()">
                            <i class="bi bi-search"></i> Scan Repositories
                        </button>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded workspace-pill bg-subtle border">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                        <div>
                            <span class="text-muted fs-xs text-uppercase fw-semibold d-block">Current Working Workspace</span>
                            <span class="font-monospace fw-medium text-break" id="current-workspace-path">@Model.Settings.WorkingFolder</span>
                        </div>
                        <div>
                            <span class="badge bg-secondary-subtle text-secondary border px-3 py-2" id="repos-count-badge">
                                <i class="bi bi-git me-1 text-primary"></i> @Model.TotalRepositoriesFound repositories discovered
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action Cards Grid -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card h-100 p-3 border-0 shadow-sm bg-card">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="icon-box bg-primary-subtle text-primary rounded p-2">
                                <i class="bi bi-folder-check fs-4"></i>
                            </div>
                            <h5 class="fw-semibold mb-0">Repositories</h5>
                        </div>
                        <p class="text-muted fs-sm mb-3">Browse all detected Git repositories, branches, and uncommitted modifications.</p>
                        <a href="/repositories" class="btn btn-sm btn-outline-primary mt-auto d-flex align-items-center justify-content-between">
                            <span>View All Repositories</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 p-3 border-0 shadow-sm bg-card">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="icon-box bg-success-subtle text-success rounded p-2">
                                <i class="bi bi-lightning-charge fs-4"></i>
                            </div>
                            <h5 class="fw-semibold mb-0">Fast Scan</h5>
                        </div>
                        <p class="text-muted fs-sm mb-3">Recursively discover submodules, worktrees, and project folders without external tools.</p>
                        <button onclick="triggerScan()" class="btn btn-sm btn-outline-success mt-auto d-flex align-items-center justify-content-between">
                            <span>Re-scan Directory</span>
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card h-100 p-3 border-0 shadow-sm bg-card">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="icon-box bg-info-subtle text-info rounded p-2">
                                <i class="bi bi-sliders fs-4"></i>
                            </div>
                            <h5 class="fw-semibold mb-0">Settings & Git</h5>
                        </div>
                        <p class="text-muted fs-sm mb-3">Configure Git executable path, dark/light themes, and startup options.</p>
                        <a href="/settings" class="btn btn-sm btn-outline-secondary mt-auto d-flex align-items-center justify-content-between">
                            <span>Open Settings</span>
                            <i class="bi bi-gear"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Recent Repositories Section -->
            <div class="card border-0 shadow-sm bg-card">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-clock-history me-2 text-muted"></i> Discovered Repositories
                    </h5>
                    <a href="/repositories" class="text-decoration-none fs-sm fw-medium">View all (@Model.TotalRepositoriesFound) &rarr;</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentRepositories.Any())
                    {
                        <div class="list-group list-group-flush" id="recent-repos-list">
                            @foreach (var repo in Model.RecentRepositories)
                            {
                                <a href="/repository/@repo.Id?path=@Uri.EscapeDataString(repo.Path)" class="list-group-item list-group-item-action p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="fw-bold fs-6 text-primary">@repo.Name</span>
                                            <span class="badge branch-pill"><i class="bi bi-bezier2 me-1"></i> @repo.CurrentBranch</span>
                                            @if (!repo.IsClean)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@repo.ChangesCount changes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">clean</span>
                                            }
                                        </div>
                                        <div class="text-muted fs-xs font-monospace">@repo.Path</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(repo.LastCommitMessage))
                                        {
                                            <span class="text-muted fs-xs d-none d-lg-inline text-truncate" style="max-width: 250px;">
                                                <i class="bi bi-commit me-1"></i> @repo.LastCommitMessage
                                            </span>
                                        }
                                        <button class="btn btn-sm btn-outline-primary ms-md-2">
                                            Open <i class="bi bi-chevron-right ms-1"></i>
                                        </button>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-folder-x fs-1 mb-2 d-block"></i>
                            <h6 class="fw-semibold">No Git repositories discovered</h6>
                            <p class="fs-sm mb-3">No directory containing a <code>.git</code> repository was found inside the selected folder.</p>
                            <button class="btn btn-sm btn-primary" onclick="promptWorkspaceFolder()">Select Another Workspace</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Workspace Modal -->
<div class="modal fade" id="workspaceModal" tabindex="-1" aria-labelledby="workspaceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-card border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="workspaceModalLabel"><i class="bi bi-folder2-open text-primary me-2"></i>Select Workspace Folder</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <label for="workspaceInput" class="form-label fw-semibold fs-sm">Workspace Directory Path</label>
                <div class="input-group mb-3">
                    <input type="text" class="form-control font-monospace fs-sm" id="workspaceInput" value="@Model.Settings.WorkingFolder" placeholder="e.g. C:\Projects or E:\Asp.NET Work" />
                    <button class="btn btn-primary d-flex align-items-center gap-2" type="button" id="btn-native-picker" onclick="openNativeFolderPicker()">
                        <i class="bi bi-window-sidebar"></i> <span>Browse File Manager</span>
                    </button>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fs-xs text-muted text-uppercase fw-bold">Or Select Drive & Subfolder:</span>
                    <button class="btn btn-xs btn-link text-decoration-none p-0 fs-xs" onclick="navigateParentFolder()"><i class="bi bi-arrow-up-circle me-1"></i>Up to Parent</button>
                </div>

                <!-- Drive Selector Pills -->
                <div class="d-flex flex-wrap gap-2 mb-3" id="drive-pills-container">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>

                <!-- Subfolder Grid List -->
                <div class="border rounded p-2 bg-subtle" style="max-height: 220px; overflow-y: auto;" id="folder-list-container">
                    <div class="p-3 text-center text-muted fs-sm">Loading folder contents...</div>
                </div>

                <div class="form-text fs-xs text-muted mt-3">
                    <i class="bi bi-info-circle me-1"></i> LGMS will scan all Git repositories inside the selected folder.
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitWorkspaceChange()">
                    <i class="bi bi-check2 me-1"></i> Set & Scan Workspace
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentNavPath = "";

    function promptWorkspaceFolder() {
        const current = document.getElementById('current-workspace-path').innerText.trim();
        const input = document.getElementById('workspaceInput');
        if (input) input.value = current;
        currentNavPath = current;
        
        const modalEl = document.getElementById('workspaceModal');
        if (modalEl && typeof bootstrap !== 'undefined') {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
            loadDrives();
            loadSubfolders(current);
        } else {
            openNativeFolderPicker();
        }
    }

    async function openNativeFolderPicker() {
        const btn = document.getElementById('btn-native-picker');
        if (btn) btn.disabled = true;
        LGMS.toast("Opening file manager dialog...", "info");
        try {
            const res = await fetch('/api/workspace/browse-native', { method: 'POST' });
            const data = await res.json();
            if (data.success && data.folder) {
                document.getElementById('workspaceInput').value = data.folder;
                LGMS.toast(`✓ Selected folder: ${data.folder}`, "success");
                await applyWorkspace(data.folder);
            } else if (data.message && data.message !== "No folder selected or dialog cancelled.") {
                LGMS.toast(data.message, "warning");
            }
        } catch (e) {
            LGMS.toast("Failed to open file manager dialog", "error");
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function loadDrives() {
        const container = document.getElementById('drive-pills-container');
        if (!container) return;
        try {
            const res = await fetch('/api/filesystem/drives');
            const data = await res.json();
            if (data.success && data.drives) {
                container.innerHTML = data.drives.map(d => `
                    <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1" onclick="selectAndBrowseFolder('${d.name.replace(/\\/g, '\\\\')}')">
                        <i class="bi bi-hdd"></i> <strong>${d.name}</strong> <span class="fs-xs text-muted">(${d.volumeLabel})</span>
                    </button>
                `).join('');
            }
        } catch (e) {
            container.innerHTML = '<span class="text-muted fs-xs">Drives unavailable</span>';
        }
    }

    async function loadSubfolders(path) {
        const container = document.getElementById('folder-list-container');
        if (!container) return;
        container.innerHTML = '<div class="p-3 text-center text-muted fs-sm"><div class="spinner-border spinner-border-sm me-2"></div> Loading directory...</div>';
        try {
            const res = await fetch(`/api/filesystem/folders?path=${encodeURIComponent(path)}`);
            const data = await res.json();
            if (data.success) {
                currentNavPath = data.current;
                if (!data.subfolders || data.subfolders.length === 0) {
                    container.innerHTML = '<div class="p-3 text-center text-muted fs-xs">No accessible subdirectories found in this folder.</div>';
                    return;
                }
                container.innerHTML = `
                    <div class="list-group list-group-flush">
                        ${data.subfolders.map(f => `
                            <div class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-2 cursor-pointer" onclick="selectAndBrowseFolder('${f.path.replace(/\\/g, '\\\\')}')">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <i class="bi ${f.isGit ? 'bi-git text-danger' : 'bi-folder2 text-warning'} fs-5"></i>
                                    <span class="fs-sm fw-medium">${f.name}</span>
                                    ${f.isGit ? '<span class="badge bg-danger-subtle text-danger fs-xs">git repo</span>' : ''}
                                </div>
                                <button type="button" class="btn btn-xs btn-outline-primary" onclick="event.stopPropagation(); selectFolderOnly('${f.path.replace(/\\/g, '\\\\')}')">
                                    Choose
                                </button>
                            </div>
                        `).join('')}
                    </div>
                `;
            } else {
                container.innerHTML = `<div class="p-3 text-center text-danger fs-xs">${data.message || "Failed to load directory"}</div>`;
            }
        } catch (e) {
            container.innerHTML = '<div class="p-3 text-center text-danger fs-xs">Error reading directory.</div>';
        }
    }

    function selectFolderOnly(path) {
        document.getElementById('workspaceInput').value = path;
        currentNavPath = path;
    }

    function selectAndBrowseFolder(path) {
        document.getElementById('workspaceInput').value = path;
        currentNavPath = path;
        loadSubfolders(path);
    }

    function navigateParentFolder() {
        if (!currentNavPath) return;
        const parts = currentNavPath.split(/[\/\\]/).filter(Boolean);
        if (parts.length > 1) {
            parts.pop();
            const parent = parts.join('\\') + (parts.length === 1 ? '\\' : '');
            selectAndBrowseFolder(parent);
        }
    }

    async function submitWorkspaceChange() {
        const folder = document.getElementById('workspaceInput').value.trim();
        if (!folder) {
            LGMS.toast("Please enter or choose a valid directory path", "warning");
            return;
        }
        await applyWorkspace(folder);
    }

    async function applyWorkspace(folderPath) {
        LGMS.showLoading("Updating Workspace", "Setting workspace path and scanning repositories...");
        try {
            const res = await fetch('/api/workspace', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ workingFolder: folderPath })
            });
            const data = await res.json();
            if (data.success) {
                LGMS.toast("Workspace updated successfully", "success");
                window.location.href = '/?workspace=' + encodeURIComponent(data.folder || folderPath);
            } else {
                LGMS.hideLoading();
                LGMS.toast(data.message || "Failed to update workspace", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast("Error communicating with server", "error");
        }
    }

    async function triggerScan() {
        LGMS.showLoading("Scanning Repositories", "Enumerating local directories safely...");
        try {
            const res = await fetch('/api/repositories');
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ Scanned successfully. Found ${data.total} repositories.`, "success");
                setTimeout(() => location.reload(), 600);
            } else {
                LGMS.toast(data.message || "Scanning failed", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast("Scan request error", "error");
        }
    }
</script>
}
