@model LGMS.ViewModels.BranchViewModel
@{
    ViewData["Title"] = $"{Model.Repository.Name} — Branches";
    var repo = Model.Repository;
    ViewBag.Repository = repo;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="/repository/@repo.Id?path=@Uri.EscapeDataString(repo.Path)" class="text-muted text-decoration-none">@repo.Name</a>
                <span class="text-muted">/</span>
                <span class="badge branch-pill"><i class="bi bi-bezier2 me-1"></i> @Model.CurrentBranch</span>
            </div>
            <h3 class="fw-bold mb-0">Branch Management</h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary d-flex align-items-center gap-1" onclick="location.reload();">
                <i class="bi bi-arrow-clockwise"></i> <span>Refresh</span>
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#newBranchModal">
                <i class="bi bi-plus-lg"></i> <span>Create Branch</span>
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Local Branches -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm bg-card h-100">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-laptop me-2 text-primary"></i> Local Branches (@Model.LocalBranches.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var b in Model.LocalBranches)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3 @(b.IsCurrent ? "bg-subtle" : "")">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        @if (b.IsCurrent)
                                        {
                                            <span class="text-success fs-5">●</span>
                                            <span class="fw-bold text-primary">@b.Name</span>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">CURRENT</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-5">○</span>
                                            <span class="fw-medium">@b.Name</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(b.LatestCommitSubject))
                                    {
                                        <div class="text-muted fs-xs font-monospace text-truncate" style="max-width: 320px;">
                                            <span class="text-secondary">@b.LatestCommitHash</span> @b.LatestCommitSubject
                                        </div>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    @if (!b.IsCurrent)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" onclick="checkoutBranch('@b.Name')">
                                            Checkout
                                        </button>
                                        <button class="btn btn-sm btn-outline-info" onclick="mergeBranch('@b.Name')">
                                            Merge
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="confirmDeleteBranch('@b.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Remote Branches -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm bg-card h-100">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-cloud-arrow-down me-2 text-info"></i> Remote Tracking Branches (@Model.RemoteBranches.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.RemoteBranches.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var b in Model.RemoteBranches)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <i class="bi bi-cloud text-secondary"></i>
                                            <span class="fw-medium font-monospace">@b.Name</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(b.LatestCommitSubject))
                                        {
                                            <div class="text-muted fs-xs font-monospace text-truncate" style="max-width: 320px;">
                                                @b.LatestCommitSubject
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="checkoutRemoteBranch('@b.Name')">
                                            Track & Checkout
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted fs-sm">
                            <i class="bi bi-cloud-slash fs-2 mb-2 d-block text-secondary"></i>
                            No remote tracking branches configured. Add a remote in the Remotes panel.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Branch Modal -->
<div class="modal fade" id="newBranchModal" tabindex="-1" aria-labelledby="newBranchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg bg-card">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="newBranchModalLabel">
                    <i class="bi bi-bezier2 me-2 text-primary"></i> Create New Branch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold fs-sm">Source / Base</label>
                    <input type="text" class="form-control font-monospace fs-sm" value="@Model.CurrentBranch" readonly />
                </div>
                <div class="mb-3">
                    <label for="newBranchNameInput" class="form-label fw-semibold fs-sm">New Branch Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control font-monospace fs-sm" id="newBranchNameInput" placeholder="feature/new-feature" required />
                    <div class="form-text fs-xs text-muted">Use standard conventions like feature/xxx, fix/xxx, bugfix/xxx</div>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitCreateBranch()">Create Branch</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const repoPath = '@Html.Raw(repo.Path)';

    async function checkoutBranch(branchName) {
        LGMS.showLoading(`Checking out ${branchName}...`, "git checkout");
        try {
            const res = await fetch('/api/git/branch/checkout', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ path: repoPath, branch: branchName })
            });
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ Switched to branch ${branchName}`, "success");
                location.reload();
            } else {
                LGMS.toast(data.error || "Checkout failed", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast("Checkout request error", "error");
        }
    }

    async function checkoutRemoteBranch(remoteBranch) {
        const localName = remoteBranch.replace(/^origin\//, '');
        checkoutBranch(localName);
    }

    async function submitCreateBranch() {
        const branch = document.getElementById('newBranchNameInput').value.trim();
        if (!branch) {
            LGMS.toast("Branch name cannot be empty", "error");
            return;
        }

        LGMS.showLoading(`Creating branch ${branch}...`, "git checkout -b");
        try {
            const res = await fetch('/api/git/branch/create', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ path: repoPath, branch })
            });
            const data = await res.json();
            LGMS.hideLoading();
            if (data.success) {
                LGMS.toast(`✓ Branch ${branch} created`, "success");
                location.reload();
            } else {
                LGMS.toast(data.error || "Branch creation failed", "error");
            }
        } catch (e) {
            LGMS.hideLoading();
            LGMS.toast("Create branch error", "error");
        }
    }

    async function confirmDeleteBranch(branchName) {
        if (confirm(`Are you sure you want to delete branch '${branchName}'?\nThis cannot be undone if not merged.`)) {
            LGMS.showLoading(`Deleting branch ${branchName}...`, "git branch -d");
            try {
                const res = await fetch('/api/git/branch/delete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ path: repoPath, branch: branchName, force: false })
                });
                const data = await res.json();
                LGMS.hideLoading();
                if (data.success) {
                    LGMS.toast(`✓ Branch ${branchName} deleted`, "info");
                    location.reload();
                } else {
                    if (confirm(`Branch '${branchName}' is not fully merged.\nDo you want to force delete it (git branch -D)?`)) {
                        LGMS.showLoading(`Force deleting branch ${branchName}...`, "git branch -D");
                        const forceRes = await fetch('/api/git/branch/delete', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ path: repoPath, branch: branchName, force: true })
                        });
                        const forceData = await forceRes.json();
                        LGMS.hideLoading();
                        if (forceData.success) {
                            LGMS.toast(`✓ Branch ${branchName} force deleted`, "info");
                            location.reload();
                        } else {
                            LGMS.toast(forceData.error || "Delete failed", "error");
                        }
                    }
                }
            } catch (e) {
                LGMS.hideLoading();
                LGMS.toast("Delete error", "error");
            }
        }
    }

    async function mergeBranch(branchName) {
        if (confirm(`Merge '${branchName}' into current branch?`)) {
            LGMS.showLoading(`Merging ${branchName}...`, "git merge");
            try {
                const res = await fetch('/api/git/branch/merge', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ path: repoPath, branch: branchName })
                });
                const data = await res.json();
                LGMS.hideLoading();
                if (data.success) {
                    LGMS.toast(`✓ Branch ${branchName} merged successfully`, "success");
                    location.reload();
                } else {
                    LGMS.toast(data.error || "Merge conflicts encountered", "error");
                }
            } catch (e) {
                LGMS.hideLoading();
                LGMS.toast("Merge request error", "error");
            }
        }
    }
</script>
}
